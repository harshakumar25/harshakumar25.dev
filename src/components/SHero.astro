---
import AWaves from './AWaves.astro'
import ASeparator from './ASeparator.astro'
---

<div class="s-hero" data-intersect>
  <AWaves class="s__waves" />

  <div class="s__content js-content">
    <ASeparator
      class="s__separator js-separator"
      strings={['Har', 'sh', 'Ku', 'mar', 'CN', 'CF', 'Dev']}
    />

    <div class="s__status-bar">
      <div class="s__status-left">
        <span class="s__hero-avatar-chip">
          <img
            src="/images/harsh-profile.jpg"
            alt="Harsh Kumar"
            class="s__hero-avatar-img"
            width="20"
            height="20"
          />
          <span class="s__hero-avatar-dot"></span>
        </span>
        <div class="s__status-meta">
          <span class="s__status-text">AVAILABLE FOR WORK</span>
          <span class="s__status-clock js-clock-time">UTC+05:30 01:40 AM</span>
        </div>
      </div>
    </div>

    <h1 class="s__title">
      <span class="s__title__word js-word">HARSH</span>
      <img
        class="s__title__asset js-star"
        src="/images/asset-star.svg"
        alt=""
        width="48"
        height="48"
      />
      <span class="s__title__word js-word">KUMAR</span>
      <span class="s__title__floating-accent js-floating-accent">developer</span>
    </h1>

    <div class="s__tagline-bar">
      <p class="s__tagline">
        Building <strong>high-scale backend systems</strong> and contributing to open source cloud native architectures.
      </p>
      <span class="s__tagline-spec">FULLSTACK DEVELOPER // SYSTEMS</span>
    </div>

    <ASeparator
      class="s__separator js-separator"
      strings={['Ope', 'nSo', 'urc', 'eBa', 'cke', 'nd']}
    />
  </div>

  <div class="s__border js-border"></div>
</div><!-- .s-hero -->

<script>
  import Emitter from '../utils/Emitter'
  import Ticker from '../utils/Ticker'

  import { gsap } from 'gsap'
  import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin'
  import { SplitText } from 'gsap/SplitText'
  gsap.registerPlugin(DrawSVGPlugin, SplitText)

  class Section {
    el: HTMLElement
    words: NodeListOf<HTMLElement>

    isPaused: boolean
    isWaiting: boolean
    st: SplitText

    /**
     * Constructor
     */
    constructor() {
      // Elements
      this.el = document.querySelector('.s-hero')
      this.words = this.el.querySelectorAll('.js-word')

      // Properties
      this.isPaused = true
      this.isWaiting = true

      // Init
      if (document.readyState === 'complete') {
        Ticker.nextTick(this.init, this)
      } else {
        Emitter.once('siteLoaded', this.init, this)
      }
    }

    /**
     * Init
     */
    init() {
      this.splitWords()
      this.initClock()

      this.bindEvents()
    }

    /**
     * Init Clock
     */
    initClock() {
      const clockEl = this.el.querySelector('.js-clock-time')
      if (!clockEl) return

      const update = () => {
        try {
          const now = new Date()
          const formatted = new Intl.DateTimeFormat('en-US', {
            timeZone: 'Asia/Kolkata',
            hour: '2-digit',
            minute: '2-digit',
            hour12: true,
          }).format(now)
          clockEl.textContent = `UTC+05:30  ${formatted}`
        } catch (e) {}
      }

      update()
      setInterval(update, 1000)
    }

    /**
     * Bind events
     */
    bindEvents() {
      Emitter.on('resize', this.onResize, this)

      document.addEventListener('intro', this.intro.bind(this), { once: true })

      this.el.addEventListener('intersect', this.onIntersect.bind(this), {
        passive: true,
      })

      Emitter.on('tick', this.tick, this)
    }

    /**
     * Intersect handler
     */
    onIntersect(e) {
      this.isPaused = !e.detail.isIntersecting

      if (this.isPaused) {
        Emitter.off('tick', this.tick, this)
      } else {
        Emitter.on('tick', this.tick, this)
      }
    }

    /**
     * Resize handler
     */
    onResize() {
      this.splitWords()
    }

    /**
     * Intro
     */
    intro() {
      const waves = this.el.querySelector('a-waves')
      const lines = waves.querySelectorAll('.js-line')
      const content = this.el.querySelector('.js-content')
      const border = this.el.querySelector('.js-border')
      const chars = content.querySelectorAll('.char__inner')
      const separators = content.querySelectorAll('.js-separator')
      const star = content.querySelector('.js-star')

      const tl = gsap.timeline()

      tl.fromTo(
        lines,
        {
          drawSVG: '100% 100%',
        },
        {
          drawSVG: '0% 100%',
          duration: 3,
          ease: 'expo.out',
          stagger: {
            amount: 0.5,
            from: 'edges',
            ease: 'power3.inOut',
          },
        },
        0.5
      )

      tl.call(() => {
        waves.dispatchEvent(new CustomEvent('introend'))
      }, null, '-=1')

      tl.set(
        this.el,
        {
          opacity: 1,
        },
        0
      )

      tl.to(
        border,
        {
          scaleY: 0.025,
          y: -content.clientHeight,
          duration: 1,
          ease: 'expo.inOut',
        },
        0
      )

      tl.from(
        waves,
        {
          y: '100%',
          duration: 1.35,
          ease: 'expo.out',
        },
        0
      )

      tl.fromTo(
        content,
        {
          clipPath: 'polygon(0 0, 100% 0, 100% 0, 0 0)',
        },
        {
          clipPath: 'polygon(0 0, 100% 0, 100% 100%, 0 100%)',
          duration: 1,
          ease: 'expo.inOut',
        },
        1
      )

      tl.to(
        border,
        {
          scaleY: 1,
          y: 0,
          duration: 1,
          ease: 'expo.inOut',
        },
        1
      )

      tl.from(
        star,
        {
          rotate: 90,
          duration: 2,
          ease: 'expo.out',
        },
        1.5
      )

      tl.fromTo(
        chars,
        {
          y: '-200%',
        },
        {
          y: '-100%',
          duration: 2,
          ease: 'expo.inOut',
          stagger: 0.02,
        },
        0.45
      )

      tl.from(
        separators,
        {
          y: (index) => (index % 2 === 0 ? '-100%' : '100%'),
          duration: 1.5,
          ease: 'expo.inOut',
        },
        0.75
      )

      tl.call(() => {
        this.isWaiting = false
      })
    }

    /**
     * Split words
     */
    splitWords() {
      if (this.st) {
        this.st.revert()
      }

      this.st = new SplitText(this.words, {
        type: 'words,chars',
        charsClass: 'char',
        wordsClass: 'word',
      })

      this.st.chars.forEach((char: HTMLElement, index) => {
        const letter = char.textContent

        char.classList.add('char--' + letter)

        const inner = document.createElement('span')
        inner.classList.add('char__inner')

        inner.dataset.letter = letter.toUpperCase()
        inner.innerHTML = letter

        char.innerHTML = inner.outerHTML
      })
    }

    /**
     * Animate char
     */
    animateChar() {
      if (this.isWaiting || Math.random() > 0.01) return

      const char =
        this.st.chars[Math.floor(Math.random() * this.st.chars.length)]

      if (
        char.classList.contains('to-top') ||
        char.classList.contains('to-right') ||
        char.classList.contains('to-bottom') ||
        char.classList.contains('to-left')
      )
        return

      const direction = Math.floor(Math.random() * 4)

      const className = 'to-' + ['bottom', 'left', 'top', 'right'][direction]

      char.classList.add(className)

      setTimeout(() => {
        char.classList.remove(className)
      }, 2000)
    }

    /**
     * Tick
     */
    tick() {
      this.animateChar()
    }
  }

  new Section()
</script>

<style lang="scss">
  .s-hero {
    @include flex(column, stretch, stretch);

    position: relative;
    z-index: 4;

    min-height: calc(115svh - 7rem);

    opacity: 0;
    overflow: hidden;

    // Fit the name and tagline in the first screen under the stacked header
    @include mq(phone) {
      min-height: calc(100svh - 8rem);
    }

    .s__waves {
      width: 100%;
      height: 100%;
      min-height: 52vh;

      flex-grow: 1;
      flex-shrink: 0;

      @include mq(phone) {
        min-height: 38vh;
      }
    }

    .s__border {
      position: absolute;
      top: 100%;
      left: 0;

      width: 100%;
      height: 40 * 1rem;

      background: color(secondary);
      transform-origin: 50% 0;

      @include mq(phone) {
        height: 40 * 0.5rem;
      }
    }

    .s__content {
      position: relative;

      overflow: hidden;
      transform-origin: 50% 100%;

      &:before {
        position: absolute;
        top: 0;
        left: 0;

        width: 100%;
        height: 1px;

        background: color(secondary);

        content: '';
      }
    }

    .s__status-bar {
      @include flex(row, center, space-between);
      padding: 0.85rem 1.5rem 0.25rem;
      font: 400 11px / 1 font-family(fraktion);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: color(secondary);

      @include mq(phone) {
        padding: 0.5rem 0.75rem 0;
        font-size: 9px;
      }

      .s__status-left {
        @include flex(row, center, flex-start);
      }

      .s__hero-avatar-chip {
        position: relative;
        width: 20px;
        height: 20px;
        margin-right: 8px;
        border-radius: 50%;
        border: 1px solid rgba(color(secondary), 0.4);
        padding: 1px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;

        .s__hero-avatar-img {
          width: 100%;
          height: 100%;
          border-radius: 50%;
          object-fit: cover;
          object-position: center 15%;
          display: block;
        }

        .s__hero-avatar-dot {
          position: absolute;
          bottom: -1px;
          right: -1px;
          width: 5px;
          height: 5px;
          border-radius: 50%;
          background: #39e75f;
          box-shadow: 0 0 5px #39e75f;
        }
      }

      .s__status-meta {
        display: flex;
        flex-direction: column;
        gap: 2px;
        line-height: 1.15;
      }

      .s__status-dot {
        width: 6px;
        height: 6px;
        margin-right: 8px;
        border-radius: 50%;
        background: #39e75f;
        box-shadow: 0 0 8px #39e75f;
      }

      .s__status-clock {
        font-size: 9.5px;
        font-weight: 700;
        letter-spacing: 0.12em;
        opacity: 0.85;

        @include mq(phone) {
          font-size: 8px;
        }
      }
    }

    .s__title,
    .s__separator {
      flex-grow: 0;
      flex-shrink: 0;
    }

    .s__title {
      @include flex(row, center, center);
      flex-wrap: nowrap;

      margin: 0;
      padding: 1.5rem 1.5rem;

      cursor: default;

      font: 700 min(12.5vw, 15.5rem) / 0.82 font-family(bigger);
      text-transform: uppercase;
      white-space: nowrap;

      @include mq(desktop-xs) {
        font-size: 12vw;
        padding: 1.25rem 1rem;
      }

      @include mq(tablet) {
        padding: 1rem 0.75rem;
        font-size: min(13vw, 15vw);
        flex-wrap: wrap;
      }

      @include mq(phone) {
        padding: 0.75rem 0.5rem;
        font-size: calc(17vw - 0.25rem);
      }

      &__word {
        position: relative;

        display: block;
        height: 0.7975em;
        flex-shrink: 0;

        @include mq(tablet) {
          flex-grow: 0;
          flex-shrink: 0;
        }

        @include mq(phone) {
          height: 0.825em;
        }
      }

      &__asset {
        display: block;
        margin: 0 1.5rem;
        flex-shrink: 0;

        @include mq(tablet) {
          margin: 0 0.75rem;
          width: 0.3em;
          height: auto;
        }

        @include mq(phone) {
          margin: 0 0.35rem;
          width: 0.22em;
        }
      }

      &__floating-accent {
        display: inline-block;
        margin-left: 0.25em;
        flex-shrink: 0;

        font-family: font-family(editorial);
        font-style: italic;
        font-weight: 200;
        font-size: 0.35em;
        line-height: 1;
        letter-spacing: normal;
        text-transform: lowercase;
        color: color(secondary);
        opacity: 0.85;

        transform: translateY(-0.15em) rotate(-2deg);
        animation: s-hero-floating 4s ease-in-out infinite;

        @include mq(phone) {
          font-size: 0.32em;
          margin-left: 0.15em;
        }
      }

      @keyframes s-hero-move-to-left {
        0% {
          transform: translate3d(0, 0, 0);
        }

        100% {
          transform: translate3d(100%, 0, 0);
        }
      }

      @keyframes s-hero-move-to-right {
        0% {
          transform: translate3d(0, 0, 0);
        }

        100% {
          transform: translate3d(-100%, 0, 0);
        }
      }

      @keyframes s-hero-move-to-top {
        0% {
          transform: translate3d(0, 0, 0);
        }

        100% {
          transform: translate3d(0, -100%, 0);
        }
      }

      @keyframes s-hero-move-to-bottom {
        0% {
          transform: translate3d(0, 0, 0);
        }

        100% {
          transform: translate3d(0, 100%, 0);
        }
      }

      :global(.char) {
        clip-path: inset(0 0.005em);

        color: transparent;
      }

      :global(.char__inner) {
        position: relative;
        top: 0.0725em;

        display: block;

        color: transparent;

        will-change: transform;

        @at-root {
          :global(.is-windows) &,
          :global(.is-android) & {
            top: 0.1025em;

            @include mq(phone) {
              top: 0.105em;
            }
          }

          :global(.is-firefox) & {
            top: 0.1015em;
          }
        }

        &:before {
          position: absolute;
          top: 0;
          left: 50%;

          transform: translate3d(-50%, 0, 0);

          color: color(secondary);

          content: attr(data-letter) attr(data-letter) attr(data-letter);
        }

        &:after {
          position: absolute;
          top: 50%;
          left: 0;

          transform: translate3d(0, -50%, 0);

          color: color(secondary);
          word-break: break-all;

          content: attr(data-letter) attr(data-letter) attr(data-letter);
        }
      }

      :global(.char--t) {
        margin-left: -0.035em;
      }

      :global(.to-top .char__inner) {
        animation: s-hero-move-to-top 1s ease(in-out-quint) 1 forwards;
      }

      :global(.to-right .char__inner) {
        animation: s-hero-move-to-right 1s ease(in-out-quint) 1 forwards;
      }

      :global(.to-bottom .char__inner) {
        animation: s-hero-move-to-bottom 1s ease(in-out-quint) 1 forwards;
      }

      :global(.to-left .char__inner) {
        animation: s-hero-move-to-left 1s ease(in-out-quint) 1 forwards;
      }
    }

    .s__tagline-bar {
      @include flex(row, center, space-between);
      padding: 0.5rem 1.5rem 0.85rem;
      border-top: 1px dashed rgba(color(secondary), 0.2);

      @include mq(phone) {
        padding: 0.5rem 0.75rem;
      }

      .s__tagline {
        margin: 0;
        font: 400 13px / 1.4 font-family(editorial);
        color: color(secondary);
        max-width: 460px;

        strong {
          font-weight: 700;
        }

        @include mq(phone) {
          font-size: 11px;
          max-width: 68%;
        }
      }

      .s__tagline-spec {
        font: 700 9px / 1 font-family(fraktion);
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: color(secondary);
        opacity: 0.75;
        padding: 0.25rem 0.6rem;
        border: 1px solid rgba(color(secondary), 0.35);
        border-radius: 2px;
        white-space: nowrap;

        @include mq(phone) {
          font-size: 8px;
          padding: 0.2rem 0.4rem;
        }
      }
    }

    @keyframes s-hero-floating {
      0%, 100% {
        transform: translateY(-0.15em) rotate(-2deg);
      }
      50% {
        transform: translateY(-0.3em) rotate(1deg);
      }
    }
  }
</style>
