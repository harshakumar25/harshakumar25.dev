---
// SiteHead.astro - Redesigned to match brutalist editorial technical HUD
const navLinks = [
  { id: 'about', text: 'ABOUT', href: '#about' },
  { id: 'work', text: 'WORK', href: '#work', isPill: true },
  { id: 'contact', text: 'CONTACT', href: '#contact' },
  {
    id: 'linkedin',
    text: 'LINKEDIN',
    href: 'https://www.linkedin.com/in/harshakumar25/',
    target: '_blank',
  },
]
---

<header class="site-head js-site-head" data-intersect>
  <div class="site-head__grid">
    <!-- Box 1: Profile & Identity (Top Left) -->
    <div class="sh-cell sh-cell--logo">
      <a href="#about" class="sh-profile-link js-menu-link" title="Harsh Kumar">
        <div class="sh-avatar-frame js-avatar-frame">
          <img
            src="/images/harsh-profile.jpg"
            alt="Harsh Kumar"
            class="sh-avatar-img"
            width="52"
            height="52"
            loading="eager"
          />
          <span class="sh-avatar-status" title="Active / Available for Work"></span>
        </div>
        <div class="sh-profile-meta">
          <span class="sh-profile-fullname">HARSH KUMAR</span>
          <span class="sh-profile-sub">AI/ML ENGINEER</span>
        </div>
      </a>
    </div>

    <!-- Box 2: Telemetry -->
    <div class="sh-cell sh-cell--telemetry">
      <div class="sh-telemetry-inner">
        <span class="sh-t-line">FULLSTACK DEVELOPER | HackerOne Reasercher </span>
        <span class="sh-t-line">FOCUS: BUILD, SECURE, SCALE</span>
        <span class="sh-t-line">LOCATION: DELHI / MUMBAI, INDIA</span>
        <span class="sh-t-line sh-t-time js-telemetry-clock">UTC+05:30 01:40 AM</span>
      </div>
    </div>

    <!-- Box 3: Center Stack (Tech Badges + Nav Menu) -->
    <div class="sh-cell sh-cell--center">
      <!-- Top Row: Tech Badges -->
      <div class="sh-tech-strip">
        <span class="sh-badge"><span class="sh-binary">01010101</span></span>

        <span class="sh-badge">
          <svg class="sh-badge-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 2.18l7 3.12v4.7c0 4.54-3.14 8.79-7 9.88-3.86-1.09-7-5.34-7-9.88V6.3l7-3.12zM12 6a4 4 0 0 0-4 4c0 1.91 1.34 3.51 3.14 3.91L10 17h4l-1.14-3.09A4.004 4.004 0 0 0 16 10a4 4 0 0 0-4-4z"/>
          </svg>
          CYBER
        </span>

        <span class="sh-badge">
          <svg class="sh-badge-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L3.5 6.9v9.8L12 21.6l8.5-4.9V6.9L12 2zm0 2.3l6.5 3.7v7.5L12 19.3 5.5 15.5V8L12 4.3zM12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6z"/>
          </svg>
          K8S
        </span>

        <span class="sh-badge">
          <svg class="sh-badge-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2c-2.4 0-4.1 1.9-4.1 4.2 0 .9.2 1.8.8 2.5-.9 1.1-1.8 2.5-1.8 4.2 0 1.2.4 2.2 1 3-.7.8-1.5 1.5-2 2.6-.5 1.1-.3 1.9.2 2.3.6.5 1.6.4 2.8-.2.7-.4 1.5-1 2-1.7.3.1.7.1 1 .1s.7 0 1-.1c.5.7 1.3 1.3 2 1.7 1.2.6 2.2.7 2.8.2.5-.4.7-1.2.2-2.3-.5-1.1-1.3-1.8-2-2.6.6-.8 1-1.8 1-3 0-1.7-.9-3.1-1.8-4.2.6-.7.8-1.6.8-2.5 0-2.3-1.7-4.2-4.1-4.2z"/>
          </svg>
          LINUX
        </span>

        <span class="sh-badge">
          <svg class="sh-badge-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.5 4.5c-1.5.5-3.5 1.5-5 3-1.2-1.2-3-2-5.5-1.5-3 0-5 2.5-5 5.5 0 2 .8 3.8 2.2 5-1.2 1.8-2.2 3.5-2.2 4.5 1.5-.2 3.2-1 4.5-2.2 1.2 1.2 3 2 5.5 1.5 3.5-.7 5.5-3.5 5.5-6.8 0-1.5-.5-3-1.5-4.2 1-.5 2.5-1.2 3.5-1.8-1-.8-2-2-2-3z"/>
          </svg>
          KALI
        </span>

        <span class="sh-badge">
          <svg class="sh-badge-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2l8.66 5v10L12 22l-8.66-5V7L12 2zm0 2.31L5.34 8v8L12 19.69 18.66 16V8L12 4.31zM12 7l4.33 2.5v5L12 17l-4.33-2.5v-5L12 7z"/>
          </svg>
          KONFLUX
        </span>

        <span class="sh-badge">
          <svg class="sh-badge-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L2 7l10 5 10-5-10-5zm0 9L4 7.5 12 4.1l8 3.4-8 3.5zm0 3L2 12l2-1 8 4 8-4 2 1-10 5zm0 5L2 17l2-1 8 4 8-4 2 1-10 5z"/>
          </svg>
          MERN
        </span>

        <span class="sh-badge">
          <svg class="sh-badge-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M2 10h4v2H4v2h2v2H2v-6zm6 0h4v6H8v-6zm2 2h-1v2h1v-2zm4-2h4v2h-2v1h2v3h-4v-6zm2 4h1v-1h-1v1zm4-4h4v6h-4v-6zm2 2h-1v2h1v-2z"/>
          </svg>
          GO
        </span>

        <span class="sh-badge">
          <svg class="sh-badge-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 2h4v4H8V2zm4 0h4a4 4 0 0 1 0 8h-4V2zm-4 4h4v4H8V6zm0 4h4v4H8v-4zm0 4h4v4a4 4 0 0 1-4-4zm4-4h4a4 4 0 0 1 0 8h-4v-8z"/>
          </svg>
          FIGMA
        </span>

        <span class="sh-badge">
          <svg class="sh-badge-icon" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="12" cy="12" r="2.2"/>
            <path d="M12 4.5c4.1 0 7.5 3.4 7.5 7.5s-3.4 7.5-7.5 7.5S4.5 16.1 4.5 12 7.9 4.5 12 4.5m0-1.5C6.8 3 2.5 7 2.5 12s4.3 9 9.5 9 9.5-4 9.5-9-4.3-9-9.5-9z"/>
          </svg>
          REACT
        </span>

        <span class="sh-badge">
          <svg class="sh-badge-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M13 8h2v2h-2V8zm-3 0h2v2h-2V8zm-3 0h2v2H7V8zm6-3h2v2h-2V5zm-3 0h2v2h-2V5zm6 3h2v2h-2V8zm5 4.5c-.4-.3-1.4-.4-2.1-.2-.3-.7-.9-1.3-1.8-1.5-.3-.1-.6-.1-.9-.1-.2-.5-.5-.9-.9-1.2-.5-.4-1.1-.6-1.8-.6H3c-.6 0-1 .4-1 1v6c0 2.2 1.8 4 4 4h10c3.3 0 6-2.7 6-6 0-.8-.2-1.5-.5-2.1.2-.1.4-.2.5-.4z"/>
          </svg>
          DOCKER
        </span>
      </div>

      <!-- Bottom Row: Navigation Menu -->
      <nav class="sh-nav-strip">
        {
          navLinks.map((item, index) => (
            <>
              {index > 0 && <span class="sh-nav-sep">|</span>}
              <a
                href={item.href}
                target={item.target || '_self'}
                rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
                class:list={['sh-nav-link', { 'is-pill': item.isPill }, 'js-menu-link']}
              >
                <span>{item.text}</span>
              </a>
            </>
          ))
        }
      </nav>
    </div>

    <!-- Box 4: Socials & Contrast Toggle -->
    <div class="sh-cell sh-cell--actions">
      <a
        href="https://github.com/harshakumar25"
        target="_blank"
        rel="noopener noreferrer"
        class="sh-action-btn"
        title="GitHub Profile"
      >
        <svg class="sh-action-icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/>
        </svg>
      </a>

      <a
        href="https://www.linkedin.com/in/harshakumar25/"
        target="_blank"
        rel="noopener noreferrer"
        class="sh-action-btn"
        title="LinkedIn Profile"
      >
        <svg class="sh-action-icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
        </svg>
      </a>

      <button
        type="button"
        class="sh-action-btn js-contrast-toggle"
        title="Toggle contrast theme"
        aria-label="Toggle contrast theme"
      >
        <!-- Half-filled / half-stroke circle matching mockup -->
        <svg class="sh-action-icon" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/>
          <path d="M12 3v18a9 9 0 0 0 0-18z" fill="currentColor"/>
        </svg>
      </button>
    </div>

    <!-- Box 5: Collaborate CTA -->
    <a href="#contact" class="sh-cell sh-cell--cta js-menu-link" title="Collaborate">
      <div class="sh-cta-inner">
        <span class="sh-cta-line">COLLABORATE</span>
      </div>
    </a>
  </div>
</header>

<script>
  import Emitter from '../utils/Emitter'
  import Ticker from '../utils/Ticker'
  import { gsap } from 'gsap'

  class SiteHeadController {
    el: HTMLElement
    contrastButton: HTMLElement
    contrastMask: HTMLElement
    links: NodeListOf<HTMLElement>
    clockEl: HTMLElement

    constructor() {
      this.el = document.querySelector('.js-site-head')
      this.contrastButton = this.el?.querySelector('.js-contrast-toggle')
      this.contrastMask = document.querySelector('.js-contrast-mask')
      this.links = this.el?.querySelectorAll('.js-menu-link')
      this.clockEl = this.el?.querySelector('.js-telemetry-clock')

      Ticker.nextTick(this.init, this)
    }

    init() {
      this.bindEvents()
      this.initClock()
      this.initAvatarScroll()
    }

    initClock() {
      if (!this.clockEl) return

      const update = () => {
        try {
          const now = new Date()
          const formatted = new Intl.DateTimeFormat('en-US', {
            timeZone: 'Asia/Kolkata',
            hour: '2-digit',
            minute: '2-digit',
            hour12: true,
          }).format(now)
          this.clockEl.textContent = `UTC+05:30  ${formatted}`
        } catch (e) {}
      }

      update()
      setInterval(update, 1000)
    }

    initAvatarScroll() {
      const avatarFrame = this.el?.querySelector('.js-avatar-frame') as HTMLElement | null
      if (!avatarFrame) return

      let targetScale = 1.0
      let currentScale = 1.0

      const onScroll = () => {
        const scrollY = window.scrollY
        // Progressively scale up profile picture as page scrolls
        const progress = Math.min(scrollY / 500, 1)
        targetScale = 1.0 + progress * 0.28
      }

      window.addEventListener('scroll', onScroll, { passive: true })

      const tick = () => {
        currentScale += (targetScale - currentScale) * 0.1
        avatarFrame.style.transform = `scale(${currentScale.toFixed(3)})`
        requestAnimationFrame(tick)
      }
      requestAnimationFrame(tick)
    }

    bindEvents() {
      if (this.contrastButton) {
        this.contrastButton.addEventListener('click', this.toggleContrast.bind(this))
      }

      this.links?.forEach((link) => {
        link.addEventListener('click', this.moveToSection.bind(this))
      })

      if (document.documentElement.classList.contains('is-loaded')) {
        this.intro()
      } else {
        document.addEventListener('intro', this.intro.bind(this), { once: true })
      }
    }

    intro() {
      if (!this.el) return

      gsap.to(this.el, {
        opacity: 1,
        y: 0,
        duration: 1.2,
        ease: 'expo.out',
      })
    }

    toggleContrast() {
      if (!this.contrastMask) {
        document.documentElement.classList.toggle('theme-contrasted')
        return
      }

      let fromX = '0'
      let toX = '-100%'

      if (document.documentElement.classList.contains('theme-contrasted')) {
        fromX = '-100%'
        toX = '0'
      }

      gsap.fromTo(
        this.contrastMask,
        { x: fromX },
        {
          x: toX,
          duration: 0.9,
          ease: 'expo.inOut',
          onComplete: () => {
            this.contrastMask.style.transform = ''
            if (toX === '0') {
              document.documentElement.classList.remove('theme-contrasted')
            } else {
              document.documentElement.classList.add('theme-contrasted')
            }
            Emitter.emit(
              'contrastchange',
              document.documentElement.classList.contains('theme-contrasted')
                ? 'contrasted'
                : 'default'
            )
          },
        }
      )

      if (toX !== '0') {
        document.documentElement.classList.add('theme-contrasted')
      }
    }

    moveToSection(e: Event) {
      const target = (e.currentTarget as HTMLElement)?.getAttribute('href')
      if (!target || !target.startsWith('#')) return

      e.preventDefault()
      if (window.lenis) {
        window.lenis.scrollTo(target, {
          duration: 1.4,
          easing: (t: number) =>
            t < 0.5 ? 16 * t * t * t * t * t : 1 + 16 * --t * t * t * t * t,
        })
      } else {
        const el = document.querySelector(target)
        el?.scrollIntoView({ behavior: 'smooth' })
      }
    }
  }

  new SiteHeadController()
</script>

<style lang="scss">
  .site-head {
    position: relative;
    z-index: 20;
    width: 100%;
    box-sizing: border-box;
    background: color(primary);
    border-bottom: 1px solid color(secondary);
    opacity: 0;

    &__grid {
      display: flex;
      flex-direction: row;
      align-items: stretch;
      width: 100%;
      min-height: 4.5rem;
      box-sizing: border-box;

      @include mq(tablet) {
        flex-wrap: wrap;
        min-height: auto;
      }
    }

    /* Common cell styling: crisp 1px borders */
    .sh-cell {
      position: relative;
      display: flex;
      align-items: center;
      box-sizing: border-box;
      border-right: 1px solid color(secondary);

      &--logo {
        flex-shrink: 0;
        width: auto;
        min-width: 5.5rem;
        justify-content: flex-start;
        padding: 0.5rem 1.15rem;

        @include mq(phone) {
          min-width: 3.5rem;
          padding: 0.25rem 0.65rem;
        }

        .sh-profile-link {
          display: flex;
          align-items: center;
          gap: 0.75rem;
          text-decoration: none;
          color: color(secondary);
          width: 100%;
          height: 100%;

          &:hover {
            .sh-avatar-frame {
              border-color: #39e75f;
              box-shadow: 0 0 20px rgba(57, 231, 95, 0.55);
            }
          }
        }

        .sh-avatar-frame {
          position: relative;
          width: 52px;
          height: 52px;
          flex-shrink: 0;
          border-radius: 50%;
          padding: 2.5px;
          border: 1.5px solid rgba(color(secondary), 0.35);
          background: color(primary);
          transition: border-color 0.25s ease, box-shadow 0.25s ease;
          transform-origin: center center;
          will-change: transform;

          @include mq(phone) {
            width: 42px;
            height: 42px;
            padding: 1.5px;
          }
        }

        .sh-avatar-img {
          width: 100%;
          height: 100%;
          border-radius: 50%;
          object-fit: cover;
          object-position: center 15%;
          display: block;
        }

        .sh-avatar-status {
          position: absolute;
          bottom: 1px;
          right: 1px;
          width: 12px;
          height: 12px;
          border-radius: 50%;
          background: #39e75f;
          border: 2px solid color(primary);
          box-shadow: 0 0 8px rgba(57, 231, 95, 0.85);
          animation: shStatusPulse 2.4s infinite ease-in-out;

          @include mq(phone) {
            width: 10px;
            height: 10px;
            border-width: 1.5px;
          }
        }

        .sh-profile-meta {
          display: flex;
          flex-direction: column;
          align-items: flex-start;
          gap: 2px;

          @include mq(tablet-sm) {
            display: none;
          }
        }

        .sh-profile-fullname {
          font-family: font-family(fraktion);
          font-weight: 700;
          font-size: 13.5px;
          line-height: 1;
          letter-spacing: 0.16em;
          text-transform: uppercase;
          color: color(secondary);
          white-space: nowrap;
        }

        .sh-profile-sub {
          font-family: font-family(fraktion);
          font-weight: 700;
          font-size: 8px;
          line-height: 1;
          letter-spacing: 0.14em;
          text-transform: uppercase;
          color: #246b45;
          opacity: 0.9;
          white-space: nowrap;
        }
      }

      &--telemetry {
        flex-shrink: 0;
        padding: 0.75rem 1.25rem;
        justify-content: flex-start;

        @include mq(desktop-xs) {
          padding: 0.5rem 0.75rem;
        }

        @include mq(tablet-sm) {
          display: none;
        }

        .sh-telemetry-inner {
          display: flex;
          flex-direction: column;
          gap: 2px;
          font: 500 10px / 1.35 font-family(fraktion);
          letter-spacing: 0.08em;
          text-transform: uppercase;
          color: color(secondary);
        }

        .sh-t-line {
          white-space: nowrap;
          opacity: 0.85;
        }

        .sh-t-time {
          font-weight: 700;
          opacity: 1;
        }
      }

      &--center {
        flex: 1 1 auto;
        flex-direction: column;
        justify-content: space-between;
        align-items: stretch;
        min-width: 0;

        @include mq(tablet) {
          order: 6;
          width: 100%;
          border-right: 0;
          border-top: 1px solid color(secondary);
        }
      }

      &--actions {
        flex-shrink: 0;
        display: flex;
        flex-direction: row;
        align-items: stretch;

        .sh-action-btn {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 2.85rem;
          height: 100%;
          min-height: 4.5rem;
          background: transparent;
          border: 0;
          border-right: 1px solid color(secondary);
          color: color(secondary);
          cursor: pointer;
          text-decoration: none;
          transition: background-color 0.2s ease, color 0.2s ease;

          &:last-child {
            border-right: 0;
          }

          &:hover {
            background-color: color(secondary);
            color: color(primary);
          }

          @include mq(phone) {
            width: 2.5rem;
            min-height: 3.5rem;
          }
        }

        .sh-action-icon {
          width: 1.15rem;
          height: 1.15rem;
        }
      }

      &--cta {
        flex-shrink: 0;
        padding: 0.75rem 1.5rem;
        text-decoration: none;
        color: color(secondary);
        justify-content: center;
        border-right: 0;
        transition: background-color 0.2s ease, color 0.2s ease;

        &:hover {
          background-color: color(secondary);
          color: color(primary);
        }

        @include mq(desktop-xs) {
          padding: 0.5rem 0.85rem;
        }

        @include mq(tablet-sm) {
          display: none;
        }

        .sh-cta-inner {
          display: flex;
          align-items: center;
          justify-content: center;
          font: 700 11px / 1 font-family(fraktion);
          letter-spacing: 0.12em;
          text-transform: uppercase;
          white-space: nowrap;
        }
      }
    }

    /* Center Section Top Row: Tech Badges Strip */
    .sh-tech-strip {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 0.45rem 1rem;
      border-bottom: 1px solid color(secondary);
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;

      &::-webkit-scrollbar {
        display: none;
      }

      .sh-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font: 600 9.5px / 1 font-family(fraktion);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: color(secondary);
        white-space: nowrap;
        opacity: 0.9;
        transition: opacity 0.15s ease, transform 0.15s ease;

        &:hover {
          opacity: 1;
          transform: translateY(-1px);
        }
      }

      .sh-binary {
        font-weight: 700;
        letter-spacing: 0.15em;
        opacity: 0.75;
      }

      .sh-badge-icon {
        width: 12px;
        height: 12px;
        flex-shrink: 0;
      }
    }

    /* Center Section Bottom Row: Navigation Links */
    .sh-nav-strip {
      display: flex;
