    {
      thmBadges.map((badge, index) => (
        <div
          class="s__orbit-badge js-orbit-badge js-open-thm-modal"
          data-badge-index={index}
          data-badge-id={badge.id}
          data-badge-name={badge.name}
          data-badge-cat={badge.category}
          data-badge-desc={badge.desc}
          title={`${badge.name} • ${badge.category}`}
          role="button"
          tabindex="0"
