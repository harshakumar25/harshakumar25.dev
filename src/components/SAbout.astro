<script>
  import Emitter from '../utils/Emitter'
  import Ticker from '../utils/Ticker'
  import * as THREE from 'three'

  class AboutSectionController {
    el: HTMLElement
    wrapper3D: HTMLElement
    canvas3D: HTMLCanvasElement

    threeRenderer: THREE.WebGLRenderer
    threeScene: THREE.Scene
    threeCamera: THREE.PerspectiveCamera
    threeMasterGroup: THREE.Group

    // 3D Geometry Groups & Meshes: Exactly 2 orbital circles/rings + core
    gyroGroup: THREE.Group
    ringOuter: THREE.Mesh
    ringEquatorial: THREE.Mesh
    coreSphere: THREE.Mesh

    mouse = {
      x: 0,
      y: 0,
      targetX: 0,
      targetY: 0,
    }

    // Scroll state with smooth interpolation
    scrollProgress: number = 0
    smoothProgress: number = 0
    scrollVelocity: number = 0
    lastScrollY: number = 0
    isPaused: boolean = true

    // Dynamic scale and motion metrics
    currentScale: number = 1.0
    currentMotionSpeed: number = 1.0

    constructor() {
      this.el = document.querySelector('.js-about')
      if (!this.el) return

      this.wrapper3D = this.el.querySelector('.js-3d-wrapper')
      this.canvas3D = this.el.querySelector('.js-3d-canvas')

      if (document.readyState === 'complete') {
        Ticker.nextTick(this.init, this)
      } else {
        Emitter.once('siteLoaded', this.init, this)
      }
    }

    init() {
      this.init3DScene()
      this.bindEvents()
    }

    init3DScene() {
      if (!this.canvas3D || !this.wrapper3D) return

      const width = this.wrapper3D.clientWidth || window.innerWidth
      const height = this.wrapper3D.clientHeight || 750

      this.threeScene = new THREE.Scene()
      this.threeCamera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100)
      this.threeCamera.position.z = 7.2

      this.threeRenderer = new THREE.WebGLRenderer({
        canvas: this.canvas3D,
        alpha: true,
        antialias: true,
        powerPreference: 'high-performance',
      })
      this.threeRenderer.setSize(width, height)
      this.threeRenderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2))

      // Master 3D Group
      this.threeMasterGroup = new THREE.Group()
      this.threeScene.add(this.threeMasterGroup)

      // Gyroscopic container for layered rotation
      this.gyroGroup = new THREE.Group()
      this.threeMasterGroup.add(this.gyroGroup)

      // Color scheme: charcoal #161616 and emerald green #0e4a2f
      const darkColor = 0x161616
      const emeraldColor = 0x0e4a2f

      // 1. Broad Outer Orbital Ring (Spanning across slide)
      const ringOuterGeo = new THREE.TorusGeometry(3.8, 0.016, 8, 96)
      const ringOuterMat = new THREE.MeshBasicMaterial({
        color: darkColor,
        wireframe: true,
        transparent: true,
        opacity: 0.22,
      })
      this.ringOuter = new THREE.Mesh(ringOuterGeo, ringOuterMat)
      this.ringOuter.rotation.x = Math.PI * 0.25
      this.gyroGroup.add(this.ringOuter)

      // 2. Middle Equatorial Orbital Ring (Emerald Green)
      const ringEqGeo = new THREE.TorusGeometry(3.1, 0.014, 8, 80)
      const ringEqMat = new THREE.MeshBasicMaterial({
        color: emeraldColor,
        wireframe: true,
        transparent: true,
        opacity: 0.32,
      })
      this.ringEquatorial = new THREE.Mesh(ringEqGeo, ringEqMat)
      this.ringEquatorial.rotation.x = -Math.PI * 0.38
      this.ringEquatorial.rotation.y = Math.PI * 0.15
      this.gyroGroup.add(this.ringEquatorial)

      // 3. Core Geodesic Wireframe Cluster Sphere
      const sphereGeo = new THREE.IcosahedronGeometry(1.5, 2)
      const sphereMat = new THREE.MeshBasicMaterial({
        color: darkColor,
        wireframe: true,
        transparent: true,
        opacity: 0.16,
      })
      this.coreSphere = new THREE.Mesh(sphereGeo, sphereMat)
      this.gyroGroup.add(this.coreSphere)

      // Initial position: overlaps half of the slide (positioned towards the right-center,
      // creating an overlapping spatial presence that extends across the center-right to right edge)
      this.updateGroupPlacement(width)
    }

    updateGroupPlacement(width: number) {
      if (width < 768) {
        this.threeMasterGroup.position.set(0, 0.4, -1.0)
      } else if (width < 1024) {
        this.threeMasterGroup.position.set(0.8, 0.1, 0)
      } else {
        // Desktop: Positioned to overlap across the center-right reading column and right rail
        this.threeMasterGroup.position.set(1.1, 0.15, 0)
      }
    }

    bindEvents() {
      window.addEventListener('resize', this.onResize.bind(this))

      window.addEventListener('mousemove', (e: MouseEvent) => {
        const cx = window.innerWidth / 2
        const cy = window.innerHeight / 2
        this.mouse.targetX = (e.clientX - cx) / cx
        this.mouse.targetY = (e.clientY - cy) / cy
      })

      this.el.addEventListener('intersect', ((e: CustomEvent) => {
        this.isPaused = !e.detail.isIntersecting
        if (!this.isPaused) {
          Emitter.on('tick', this.tick, this)
        } else {
          Emitter.off('tick', this.tick, this)
        }
      }) as EventListener)

      Emitter.on('scroll', (scrollY: number) => {
        const rect = this.el.getBoundingClientRect()
        const total = window.innerHeight + rect.height
        const current = window.innerHeight - rect.top
        this.scrollProgress = Math.max(0, Math.min(1, current / total))

        // Compute instant scroll velocity
        const delta = Math.abs(scrollY - this.lastScrollY)
        this.scrollVelocity = Math.min(delta * 0.05, 3.5)
        this.lastScrollY = scrollY
      })

      // Smooth scroll to work
      const scrollBtn = this.el.querySelector('.js-scroll-work')
      scrollBtn?.addEventListener('click', (e) => {
        e.preventDefault()
        const target = document.querySelector('#work')
        if (target) {
          if (window.lenis) {
            window.lenis.scrollTo(target, { duration: 1.4 })
          } else {
            target.scrollIntoView({ behavior: 'smooth' })
          }
        }
      })
    }

    onResize() {
      if (!this.threeRenderer || !this.threeCamera || !this.wrapper3D) return
      const width = this.wrapper3D.clientWidth || window.innerWidth
      const height = this.wrapper3D.clientHeight || 750

      this.threeCamera.aspect = width / height
      this.threeCamera.updateProjectionMatrix()
      this.threeRenderer.setSize(width, height)

      this.updateGroupPlacement(width)
    }

    tick(time: number) {
      if (this.isPaused || !this.threeMasterGroup || !this.threeRenderer) return

      // Smoothly interpolate scroll progress and velocity (LERP)
      this.smoothProgress += (this.scrollProgress - this.smoothProgress) * 0.08
      this.scrollVelocity *= 0.92

      // DYNAMIC BECOMING LARGER & BROADER ON SCROLL (AND VICE-VERSA)
      // When scrolling down (progress 0 -> 1):
      // Target scale expands from 0.95 up to 1.85 (broader, larger, more commanding spatial presence)
      const targetScale = 0.95 + this.smoothProgress * 0.95
      this.currentScale += (targetScale - this.currentScale) * 0.08
      this.threeMasterGroup.scale.set(this.currentScale, this.currentScale, this.currentScale)

      // DYNAMIC MORE MOTION AS PER SCROLL (AND VICE-VERSA)
      // As scroll advances down, rotation speed intensifies from 1.0x baseline to 4.2x + scroll velocity
      const targetSpeed = 1.0 + this.smoothProgress * 3.2 + this.scrollVelocity * 1.5
      this.currentMotionSpeed += (targetSpeed - this.currentMotionSpeed) * 0.08

      // Smooth mouse tilt tracking
      this.mouse.x += (this.mouse.targetX - this.mouse.x) * 0.05
      this.mouse.y += (this.mouse.targetY - this.mouse.y) * 0.05

      // Base time step multiplied by scroll-driven motion factor
      const dt = 0.00075 * this.currentMotionSpeed
      const scrollAngle = this.smoothProgress * Math.PI * 4.2

      // Multi-axis gyroscopic rotations
      if (this.ringOuter) {
        this.ringOuter.rotation.z += dt * 0.65
        this.ringOuter.rotation.y = Math.sin(time * 0.0004) * 0.25 + this.smoothProgress * 1.5
      }

      if (this.ringEquatorial) {
        // Counter-rotating ring with dynamic inclination
        this.ringEquatorial.rotation.z -= dt * 0.95
        this.ringEquatorial.rotation.x = -Math.PI * 0.38 + Math.cos(time * 0.0005) * 0.25 - this.smoothProgress * 1.8
      }

      if (this.coreSphere) {
        this.coreSphere.rotation.y += dt * 1.4
        this.coreSphere.rotation.x += dt * 0.7
      }

      // Tilt entire master group toward cursor
      this.threeMasterGroup.rotation.y = this.mouse.x * 0.45
      this.threeMasterGroup.rotation.x = -this.mouse.y * 0.35

      // Slight camera breadth adjustment on scroll
      this.threeCamera.position.z = 7.2 - this.smoothProgress * 0.8

      this.threeRenderer.render(this.threeScene, this.threeCamera)
    }
  }

  // Ambient Orbital Badges Controller
  class BadgesOrbitController {
    container: HTMLElement
    badges: HTMLElement[]
    currentAngle: number = 0
    hoveredIndex: number = -1
    isPaused: boolean = false
    rafId: number | null = null
    width: number = 0
    height: number = 0

    constructor(container: HTMLElement) {
      this.container = container
      this.badges = Array.from(container.querySelectorAll('.js-orbit-badge'))
      if (!this.badges.length) return
      this.updateDimensions()
      this.bindEvents()
      this.animate()
    }

    updateDimensions = () => {
      const rect = this.container.getBoundingClientRect()
      this.width = rect.width || window.innerWidth
      this.height = rect.height || 650
    }

    bindEvents() {
      window.addEventListener('resize', this.updateDimensions, { passive: true })

      this.badges.forEach((badge, idx) => {
        badge.addEventListener('mouseenter', () => {
          this.hoveredIndex = idx
          badge.classList.add('is-hovered')
        })
        badge.addEventListener('mouseleave', () => {
          this.hoveredIndex = -1
          badge.classList.remove('is-hovered')
        })
      })

      const aboutEl = document.querySelector('#about')
      if (aboutEl) {
        aboutEl.addEventListener('intersect', ((e: CustomEvent) => {
          this.isPaused = !e.detail.isIntersecting
          if (!this.isPaused && !this.rafId) {
            this.animate()
          }
        }) as EventListener)
      }
    }

    animate = () => {
      if (this.isPaused) {
        this.rafId = null
        return
      }

      // Gentle orbital circulation; slower when examining a badge
      const speed = this.hoveredIndex >= 0 ? 0.0006 : 0.0022
      this.currentAngle += speed

      const width = this.width || window.innerWidth
      const height = this.height || 650

      // Elliptical orbit center and radii
      const cx = width * 0.52
      const cy = height * 0.50
      const rx = Math.min(width * 0.44, 520)
      const ry = Math.min(height * 0.36, 230)

      this.badges.forEach((badge, idx) => {
        if (idx === this.hoveredIndex) {
          badge.style.opacity = '1'
          badge.style.zIndex = '100'
          return
        }

        const angle = this.currentAngle + (idx / this.badges.length) * Math.PI * 2
        const cos = Math.cos(angle)
        const sin = Math.sin(angle)
        // 3D tilted orbit plane (-15 degrees)
        const x = cx + cos * rx - 29
        const y = cy + sin * ry - cos * 24 - 32

        // Depth projection: badges closer to viewer have higher scale and slightly higher opacity
        const depth = (sin + 1) * 0.5 // 0.0 (back) to 1.0 (front)
        const scale = 0.72 + depth * 0.28
        const opacity = 0.22 + depth * 0.2

        badge.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0) scale(${scale.toFixed(3)})`
        badge.style.opacity = `${opacity.toFixed(3)}`
        badge.style.zIndex = sin > 0 ? '4' : '1'
      })

      this.rafId = requestAnimationFrame(this.animate)
    }
  }

  // Initialize 3D Stage & Orbit Badges
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      new AboutSectionController()
      const orbitEl = document.querySelector('.js-badges-orbit') as HTMLElement | null
      if (orbitEl) new BadgesOrbitController(orbitEl)
    }, { once: true })
  } else {
    new AboutSectionController()
    const orbitEl = document.querySelector('.js-badges-orbit') as HTMLElement | null
    if (orbitEl) new BadgesOrbitController(orbitEl)
  }

  // TryHackMe Badges Modal Controller
  function initBadgesModal() {
    const modal = document.querySelector('.js-thm-modal')
    if (!modal) return

    const openButtons = document.querySelectorAll('.js-open-thm-modal, .js-thm-badge-trigger')
    const closeButtons = document.querySelectorAll('.js-thm-modal-close')

    const openModal = () => {
      modal.classList.add('is-active')
      modal.setAttribute('aria-hidden', 'false')
      document.body.style.overflow = 'hidden'
    }

    const closeModal = () => {
      modal.classList.remove('is-active')
      modal.setAttribute('aria-hidden', 'true')
      document.body.style.overflow = ''
    }

    openButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault()
        openModal()
      })
    })

    closeButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault()
        closeModal()
      })
    })

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-active')) {
        closeModal()
      }
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBadgesModal, { once: true })
  } else {
    initBadgesModal()
  }
</script>

