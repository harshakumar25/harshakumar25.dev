<section id="about" class="s-about js-about" data-intersect>
  <!-- Overlapping 3D Kinetic Motion Canvas (Grows larger, broader & faster on scroll) -->
  <div class="s__3d-canvas-wrapper js-3d-wrapper">
    <canvas class="s__3d-canvas js-3d-canvas"></canvas>
  </div>

  <!-- Ambient Background Badges Orbital Motion System (Unobtrusive background orbit) -->
