  },
  {
    kind: 'oss',
    org: 'Cilium',
    orgTag: 'CNCF · eBPF Networking',
    caption: '[OSS] Cilium · eBPF Datapath',
    site: 'https://github.com/cilium/cilium',
    logo: '/images/logos/cilium.png',
    accent: '#f59e0b',
    status: 'ACTIVE',
    stats: [
      { k: 'PRs Merged',   v: '3' },
      { k: 'Bugs Fixed',   v: '2' },
      { k: 'Issues Filed', v: '6' },
      { k: 'Area',         v: 'XDP/BPF' },
    ],
    signal: 'XDP ingress filter · tc hook perf tuning',
  },
  {
    kind: 'oss',
    org: 'Antrea',
    orgTag: 'CNCF · OVS CNI',
    caption: '[OSS] Antrea · OVS Flow Reconciler',
    site: 'https://github.com/antrea-io/antrea',
    logo: '/images/logos/antrea.svg',
    accent: '#60a5fa',
    status: 'ACTIVE',
    stats: [
      { k: 'PRs Merged',   v: '4' },
      { k: 'Bugs Fixed',   v: '3' },
      { k: 'Issues Filed', v: '7' },
      { k: 'Area',         v: 'Datapath' },
    ],
    signal: 'OVS pipeline · Multi-cluster routing',
  },
  {
    kind: 'oss',
    org: 'Kubescape',
    orgTag: 'CNCF · Security Posture',
    caption: '[OSS] Kubescape · CIS Benchmarks',
    site: 'https://github.com/kubescape/kubescape',
    logo: '/images/logos/kubescape.svg',
    accent: '#ff5f56',
    status: 'ACTIVE',
    stats: [
      { k: 'PRs Merged',   v: '2' },
      { k: 'Bugs Fixed',   v: '1' },
      { k: 'Issues Filed', v: '4' },
      { k: 'Area',         v: 'Posture' },
    ],
    signal: 'CIS rule assessor · Risk scoring',
  },
]

const works = projects
---

<section id="work" class="s-work" data-intersect>
  <div class="s__outer">
    <div class="s__inner js-container">
      <h2 class="s__title">
        <span class="s__title__inner js-title">
          <span class="s__title__letter js-letter">W</span>
          <span class="s__title__letter js-letter">O</span>
          <span class="s__title__letter js-letter">R</span>
          <span class="s__title__letter js-letter">K</span>
        </span>
      </h2>



      <div class="s__categories-nav">
        <span class="s__cat-item"><span class="s__cat-num">01</span> SHIPPED</span>
        <span class="s__cat-divider">/</span>
        <span class="s__cat-item"><span class="s__cat-num">02</span> BUILDING</span>
        <span class="s__cat-divider">/</span>
        <span class="s__cat-item"><span class="s__cat-num">03</span> OSS · CNCF</span>
        <span class="s__cat-divider">/</span>
        <span class="s__cat-item"><span class="s__cat-num">04</span> STEALTH R&D</span>
      </div>

      <div class="s__scene js-scene">
        {
          works.map((work, index) => (
            <AWork
              cssClass={`s__scene__work s__scene__work--${work.kind} js-work`}
              caption={work.caption}
              site={work.site}
              image={work.image}
              kind={work.kind}
              project={work}
              index={String(index).padStart(4, '0')}
              total={String(works.length).padStart(2, '0')}
            />
          ))
        }
      </div><!-- .s__scene -->

      <canvas class="s__canvas js-canvas"></canvas>

      <div class="s__contrib-hud">
        <div class="s__contrib-metrics">
          <span class="s__contrib-chip s__contrib-chip--h1">
            <span class="s__chip-led s__chip-led--amber"></span>
            <strong>HACKERONE:</strong> RESEARCHER
          </span>
          <span class="s__contrib-chip s__contrib-chip--gh">
            <span class="s__chip-led s__chip-led--green"></span>
            <strong>CNCF:</strong> 7 ORGS · 20+ PRs MERGED
          </span>
          <button
            type="button"
            class="s__contrib-chip s__contrib-chip--thm js-open-thm-modal"
            title="Click to view all 12 TryHackMe badges"
          >
            <span class="s__chip-led s__chip-led--amber"></span>
            <strong>TRYHACKME:</strong> TOP 4% // 12 BADGES ↗
          </button>
        </div>

        <div class="s__contrib-scale">
          <span class="s__scale-text">LESS</span>
          <span class="s__scale-cell s__scale-cell--0"></span>
          <span class="s__scale-cell s__scale-cell--1"></span>
          <span class="s__scale-cell s__scale-cell--2"></span>
          <span class="s__scale-cell s__scale-cell--3"></span>
          <span class="s__scale-cell s__scale-cell--4"></span>
          <span class="s__scale-cell s__scale-cell--5" title="Gold Milestone"></span>
          <span class="s__scale-text">MORE</span>
        </div>
      </div>
    </div><!-- .s__inner -->

    <div class="s__mask-outer">
      <div class="s__mask js-mask">
        <svg class="s__mask__svg js-mask-svg">
          <path class="s__mask__path-inner js-mask-path-inner" d=""></path>
          <path class="s__mask__path-outer js-mask-path-outer" d=""></path>
        </svg>
      </div><!-- .s__mask -->

      <!-- Tech Stack Circuit Diagram on the Outside Layer -->
      <div class="s__stack-outside js-stack-outside" aria-hidden="true">
        <!-- Top Corner Meta Labels -->
        <div class="s__stack-top js-stack-top">
          <div class="s__stack-corner s__stack-corner--tl">
            <div class="s__corner-avatar-chip" title="Harsh Kumar">
              <img
                src="/images/harsh-profile.jpg"
                alt="Harsh Kumar"
                class="s__corner-avatar-img"
                width="22"
                height="22"
              />
              <span class="s__corner-avatar-led"></span>
            </div>
            <span class="s__stack-rule"></span>
            <span class="s__stack-corner-text">SELECTED WORK / 2024 - 2026</span>
          </div>
          <div class="s__stack-corner s__stack-corner--tr">
            <span class="s__stack-corner-text">INDEPENDENT DEVELOPER</span>
            <span class="s__corner-badge">SYS_ONLINE</span>
          </div>
        </div>

        <!-- Vertical Binary Stem (Centered above the capsule top apex) -->
        <div class="s__stack-stem s__stack-stem--top js-stack-stem-top">
          <span class="s__stem-badge">
            <span class="s__stem-led"></span>
            <span class="s__stem-binary">01010101</span>
            <span class="s__stem-tag">CORE_BUS</span>
          </span>
        </div>

        <!-- Left Column: Infrastructure / Security / Systems -->
        <div class="s__stack-col s__stack-col--left js-stack-left">
          <!-- 1. Kubernetes -->
          <div class="s__stack-node js-stack-node" data-id="kubernetes">
            <div class="s__stack-card">
              <div class="s__stack-icon-wrap">
                <svg viewBox="0 0 100 100" class="s__stack-icon">
                  <polygon points="50,4 89.8,24 89.8,70 50,90 10.2,70 10.2,24" fill="#326CE5"/>
                  <g fill="#FFFFFF">
                    <circle cx="50" cy="47" r="14"/>
                    <circle cx="50" cy="47" r="8" fill="#326CE5"/>
                    <circle cx="50" cy="47" r="3" fill="#FFFFFF"/>
                    <path d="M48.5 24 h3 v10 h-3 z"/>
                    <path d="M48.5 24 h3 v10 h-3 z" transform="rotate(51.4 50 47)"/>
                    <path d="M48.5 24 h3 v10 h-3 z" transform="rotate(102.8 50 47)"/>
                    <path d="M48.5 24 h3 v10 h-3 z" transform="rotate(154.3 50 47)"/>
                    <path d="M48.5 24 h3 v10 h-3 z" transform="rotate(205.7 50 47)"/>
                    <path d="M48.5 24 h3 v10 h-3 z" transform="rotate(257.1 50 47)"/>
                    <path d="M48.5 24 h3 v10 h-3 z" transform="rotate(308.6 50 47)"/>
                    <circle cx="50" cy="22" r="3.2"/>
                    <circle cx="50" cy="22" r="3.2" transform="rotate(51.4 50 47)"/>
                    <circle cx="50" cy="22" r="3.2" transform="rotate(102.8 50 47)"/>
                    <circle cx="50" cy="22" r="3.2" transform="rotate(154.3 50 47)"/>
                    <circle cx="50" cy="22" r="3.2" transform="rotate(205.7 50 47)"/>
                    <circle cx="50" cy="22" r="3.2" transform="rotate(257.1 50 47)"/>
                    <circle cx="50" cy="22" r="3.2" transform="rotate(308.6 50 47)"/>
                  </g>
                </svg>
              </div>
              <div class="s__stack-meta">
                <span class="s__stack-label">KUBERNETES</span>
                <span class="s__stack-subtag">ORCHESTRATION</span>
              </div>
            </div>
          </div>

          <!-- 2. Docker -->
          <div class="s__stack-node js-stack-node" data-id="docker-left">
            <div class="s__stack-card">
              <div class="s__stack-icon-wrap">
                <svg viewBox="0 0 70 50" class="s__stack-icon">
                  <g fill="#2496ED">
                    <rect x="25" y="6" width="5.5" height="5" rx="0.5"/>
                    <rect x="18" y="12.5" width="5.5" height="5" rx="0.5"/>
                    <rect x="25" y="12.5" width="5.5" height="5" rx="0.5"/>
                    <rect x="32" y="12.5" width="5.5" height="5" rx="0.5"/>
                    <rect x="11" y="19" width="5.5" height="5" rx="0.5"/>
                    <rect x="18" y="19" width="5.5" height="5" rx="0.5"/>
                    <rect x="25" y="19" width="5.5" height="5" rx="0.5"/>
                    <rect x="32" y="19" width="5.5" height="5" rx="0.5"/>
                    <rect x="39" y="19" width="5.5" height="5" rx="0.5"/>
                    <path d="M57.5 25.5 c-1.2-0.7-3.8-0.9-6-0.1 c-0.4-2.9-2.5-5.1-2.7-5.3 l-1.1 1 c0.1 0.1 2.1 2.1 2.2 4.9 c-1.6 0.9-4 1.3-6.7 1.3 H4.5 c-0.7 0-1.3 0.4-1.6 0.9 c-0.3 0.6-0.3 1.3 0 1.9 C5.6 35.2 14.8 40.8 28.5 40.8 c19 0 32.7-10.3 34-14 c0.1-0.4 0-1-0.3-1.3 h-4.7 z"/>
                    <circle cx="17" cy="31" r="1.3" fill="#FFFFFF"/>
                  </g>
                </svg>
              </div>
              <div class="s__stack-meta">
                <span class="s__stack-label">DOCKER</span>
                <span class="s__stack-subtag">CONTAINER / DEV</span>
              </div>
            </div>
          </div>

          <!-- 3. Linux (Official Tux) -->
          <div class="s__stack-node js-stack-node" data-id="linux">
            <div class="s__stack-card">
              <div class="s__stack-icon-wrap">
                <svg viewBox="0 0 60 70" class="s__stack-icon">
                  <ellipse cx="30" cy="46" rx="20" ry="20" fill="#222222"/>
                  <ellipse cx="30" cy="22" rx="14" ry="14" fill="#222222"/>
                  <path d="M12 36 C6 44 8 52 16 48 C14 42 13 38 12 36 Z" fill="#222222"/>
                  <path d="M48 36 C54 44 52 52 44 48 C46 42 47 38 48 36 Z" fill="#222222"/>
                  <ellipse cx="30" cy="48" rx="13" ry="16" fill="#FFFFFF"/>
                  <ellipse cx="20" cy="64" rx="10" ry="4.5" fill="#F8A825" transform="rotate(-10 20 64)"/>
                  <ellipse cx="40" cy="64" rx="10" ry="4.5" fill="#F8A825" transform="rotate(10 40 64)"/>
                  <ellipse cx="25" cy="20" rx="3.5" ry="5.5" fill="#FFFFFF"/>
                  <ellipse cx="35" cy="20" rx="3.5" ry="5.5" fill="#FFFFFF"/>
                  <circle cx="26" cy="20" r="2" fill="#000000"/>
                  <circle cx="34" cy="20" r="2" fill="#000000"/>
                  <circle cx="25.5" cy="19" r="0.7" fill="#FFFFFF"/>
                  <circle cx="33.5" cy="19" r="0.7" fill="#FFFFFF"/>
                  <path d="M24 25 C24 23 36 23 36 25 C36 29 32 32 30 32 C28 32 24 29 24 25 Z" fill="#F8A825"/>
                </svg>
              </div>
              <div class="s__stack-meta">
                <span class="s__stack-label">LINUX</span>
                <span class="s__stack-subtag">KERNEL / OS</span>
              </div>
            </div>
          </div>

          <!-- 4. Kali Linux (Official Dragon) -->
          <div class="s__stack-node js-stack-node" data-id="kali">
            <div class="s__stack-card">
              <div class="s__stack-icon-wrap">
                <img
                  src="/images/logos/kali.svg"
                  alt="Kali Linux"
                  class="s__stack-icon"
                  width="34"
                  height="34"
                  loading="lazy"
                />
              </div>
              <div class="s__stack-meta">
                <span class="s__stack-label">KALI LINUX</span>
                <span class="s__stack-subtag">SECURITY / PENTEST</span>
              </div>
            </div>
          </div>

          <!-- 5. Konflux (Official Logo) -->
          <div class="s__stack-node js-stack-node" data-id="konflux">
            <div class="s__stack-card">
              <div class="s__stack-icon-wrap">
                <img
                  src="/images/logos/konflux.png"
                  alt="Konflux"
                  class="s__stack-icon"
                  width="34"
                  height="34"
                  loading="lazy"
                />
