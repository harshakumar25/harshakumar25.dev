              <div class="s__stack-meta">
                <span class="s__stack-label">KONFLUX</span>
                <span class="s__stack-subtag">CI/CD PIPELINE</span>
              </div>
            </div>
          </div>

          <!-- 6. Cyber Security -->
          <div class="s__stack-node js-stack-node" data-id="cybersec">
            <div class="s__stack-card">
              <div class="s__stack-icon-wrap">
                <svg viewBox="0 0 50 55" class="s__stack-icon">
                  <path d="M25 3 L45 9 V24 C45 36 36 46 25 51 C14 46 5 36 5 24 V9 Z" fill="none" stroke="#246B45" stroke-width="3" stroke-linejoin="round"/>
                  <path d="M19 26 V20 C19 16.7 21.7 14 25 14 C28.3 14 31 16.7 31 20 V26" fill="none" stroke="#246B45" stroke-width="2.6" stroke-linecap="round"/>
                  <rect x="17" y="26" width="16" height="13" rx="2.5" fill="#246B45"/>
                  <circle cx="25" cy="31" r="1.5" fill="#F7F4EB"/>
                  <path d="M24.3 32 L25.7 32 L25.5 35.5 L24.5 35.5 Z" fill="#F7F4EB"/>
                </svg>
              </div>
              <div class="s__stack-meta">
                <span class="s__stack-label">CYBER SECURITY</span>
                <span class="s__stack-subtag">THREAT DEFENSE</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Frameworks / Languages -->
        <div class="s__stack-col s__stack-col--right js-stack-right">
          <!-- 1. MERN Stack (MongoDB, Express, React, Node.js) -->
          <div class="s__stack-node js-stack-node" data-id="mern">
            <div class="s__stack-card">
              <div class="s__stack-icon-wrap s__stack-icon-wrap--mern">
                <svg viewBox="0 0 28 32" class="s__mern-subicon" title="MongoDB">
                  <path d="M14 2 C9 8 8 15 10 21 C12 26 13.5 28 14 30 C14.5 28 16 26 18 21 C20 15 19 8 14 2 Z" fill="#13AA52"/>
                  <path d="M14 6 L14 27" stroke="#F7F4EB" stroke-width="0.8"/>
                </svg>
                <span class="s__mern-badge">ex</span>
                <svg viewBox="0 0 32 32" class="s__mern-subicon" title="React">
                  <circle cx="16" cy="16" r="2.2" fill="#61DAFB"/>
                  <ellipse cx="16" cy="16" rx="13" ry="4.5" fill="none" stroke="#61DAFB" stroke-width="1.6"/>
                  <ellipse cx="16" cy="16" rx="13" ry="4.5" fill="none" stroke="#61DAFB" stroke-width="1.6" transform="rotate(60 16 16)"/>
                  <ellipse cx="16" cy="16" rx="13" ry="4.5" fill="none" stroke="#61DAFB" stroke-width="1.6" transform="rotate(-60 16 16)"/>
                </svg>
                <svg viewBox="0 0 32 32" class="s__mern-subicon" title="Node.js">
                  <polygon points="16,3 28,10 28,22 16,29 4,22 4,10" fill="#539E43"/>
                  <text x="16" y="20" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10.5" font-weight="800" fill="#FFFFFF">JS</text>
                </svg>
              </div>
              <div class="s__stack-meta">
                <span class="s__stack-label">MERN STACK</span>
                <span class="s__stack-subtag">FULL-STACK / API</span>
              </div>
            </div>
          </div>

          <!-- 2. Go (Official Speed Lines & Logo) -->
          <div class="s__stack-node js-stack-node" data-id="go">
            <div class="s__stack-card">
              <div class="s__stack-icon-wrap">
                <svg viewBox="0 0 80 34" class="s__stack-icon s__stack-icon--wide">
                  <path d="M2 13 H18 M2 17 H22 M2 21 H16" stroke="#00ADD8" stroke-width="2.5" stroke-linecap="round"/>
                  <path d="M38 17 C38 11.5 42 7 48.5 7 C54.5 7 58 11 58 16.5 H49 V19 H58 C57.5 24 53.5 27 48.5 27 C42 27 38 22.5 38 17 Z M43 17 C43 20 45 23 48.5 23 C52 23 54 20.5 54 17.5 C54 13.5 52 11 48.5 11 C45 11 43 13.5 43 17 Z" fill="#00ADD8"/>
                  <path d="M60 17 C60 11.5 64.5 7 70.5 7 C76.5 7 81 11.5 81 17 C81 22.5 76.5 27 70.5 27 C64.5 27 60 22.5 60 17 Z M65 17 C65 20.5 67 23 70.5 23 C74 23 76 20.5 76 17 C76 13.5 74 11 70.5 11 C67 11 65 13.5 65 17 Z" fill="#00ADD8"/>
                </svg>
              </div>
              <div class="s__stack-meta">
                <span class="s__stack-label">GO</span>
                <span class="s__stack-subtag">SYSTEMS / ASYNC</span>
