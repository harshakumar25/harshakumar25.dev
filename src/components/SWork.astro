          </div>

          <!-- 3. Figma (Official 5-Color) -->
          <div class="s__stack-node js-stack-node" data-id="figma">
            <div class="s__stack-card">
              <div class="s__stack-icon-wrap">
                <svg viewBox="0 0 38 56" class="s__stack-icon">
                  <path d="M0 0 H19 V19 H0 A9.5 9.5 0 0 1 0 0 Z" fill="#F24E1E"/>
                  <path d="M19 0 H38 A9.5 9.5 0 0 1 38 19 H19 Z" fill="#FF7262"/>
                  <path d="M0 19 H19 V38 H0 A9.5 9.5 0 0 1 0 19 Z" fill="#A259FF"/>
                  <circle cx="28.5" cy="28.5" r="9.5" fill="#1ABCFE"/>
                  <path d="M0 38 H19 V38 A9.5 9.5 0 0 1 9.5 56 A9.5 9.5 0 0 1 0 46.5 Z" fill="#0ACF83"/>
                </svg>
              </div>
              <div class="s__stack-meta">
                <span class="s__stack-label">FIGMA</span>
                <span class="s__stack-subtag">UI/UX / PROTOTYPE</span>
              </div>
            </div>
          </div>

          <!-- 4. React (Official Atom) -->
          <div class="s__stack-node js-stack-node" data-id="react">
            <div class="s__stack-card">
              <div class="s__stack-icon-wrap">
                <svg viewBox="0 0 50 45" class="s__stack-icon">
                  <circle cx="25" cy="22.5" r="3.5" fill="#61DAFB"/>
                  <g fill="none" stroke="#61DAFB" stroke-width="2">
                    <ellipse cx="25" cy="22.5" rx="21" ry="8"/>
                    <ellipse cx="25" cy="22.5" rx="21" ry="8" transform="rotate(60 25 22.5)"/>
                    <ellipse cx="25" cy="22.5" rx="21" ry="8" transform="rotate(-60 25 22.5)"/>
                  </g>
                </svg>
              </div>
              <div class="s__stack-meta">
                <span class="s__stack-label">REACT</span>
                <span class="s__stack-subtag">FRONTEND ENGINE</span>
              </div>
            </div>
          </div>

          <!-- 5. Docker (Official Whale) -->
          <div class="s__stack-node js-stack-node" data-id="docker-right">
            <div class="s__stack-card">
              <div class="s__stack-icon-wrap">
                <svg viewBox="0 0 70 50" class="s__stack-icon">
                  <g fill="#2496ED">
                    <rect x="25" y="6" width="5.5" height="5" rx="0.5"/>
                    <rect x="18" y="12.5" width="5.5" height="5" rx="0.5"/>
                    <rect x="25" y="12.5" width="5.5" height="5" rx="0.5"/>
                    <rect x="32" y="12.5" width="5.5" height="5" rx="0.5"/>
                    <rect x="11" y="19" width="5.5" height="5" rx="0.5"/>
                    <rect x="18" y="19" width="5.5" height="5" rx="0.5"/>
                    <rect x="25" y="19" width="5.5" height="5" rx="0.5"/>
                    <rect x="32" y="19" width="5.5" height="5" rx="0.5"/>
                    <rect x="39" y="19" width="5.5" height="5" rx="0.5"/>
                    <path d="M57.5 25.5 c-1.2-0.7-3.8-0.9-6-0.1 c-0.4-2.9-2.5-5.1-2.7-5.3 l-1.1 1 c0.1 0.1 2.1 2.1 2.2 4.9 c-1.6 0.9-4 1.3-6.7 1.3 H4.5 c-0.7 0-1.3 0.4-1.6 0.9 c-0.3 0.6-0.3 1.3 0 1.9 C5.6 35.2 14.8 40.8 28.5 40.8 c19 0 32.7-10.3 34-14 c0.1-0.4 0-1-0.3-1.3 h-4.7 z"/>
                    <circle cx="17" cy="31" r="1.3" fill="#FFFFFF"/>
                  </g>
                </svg>
              </div>
              <div class="s__stack-meta">
                <span class="s__stack-label">DOCKER</span>
                <span class="s__stack-subtag">DEPLOY / RUNTIME</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Dynamic SVG Circuit Traces (Thunder Design) -->
        <svg class="s__stack-wires js-stack-wires" aria-hidden="true"></svg>

        <!-- Bottom Footer -->
        <div class="s__stack-foot js-stack-bot">
          <span class="s__foot-lead">A FEW THINGS I'VE BUILT</span>
          <span class="s__stack-arrow">↓</span>
          <span class="s__foot-sub">[ SCROLL TO ENTER MAINFRAME ]</span>
        </div>
      </div><!-- .s__stack-outside -->
    </div><!-- .s__mask-outer -->

    <div class="s__ruler js-ruler"></div>
  </div><!-- .s__outer -->
</section>

<script>
  import Emitter from '../utils/Emitter'
  import Ticker from '../utils/Ticker'

  import { gsap } from 'gsap'
  import { SlowMo } from 'gsap/EasePack'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger, SlowMo)

  class Section {
    el: HTMLElement
    container: HTMLElement
    ruler: HTMLElement
    scene: HTMLElement
    canvas: HTMLCanvasElement
    ctx: CanvasRenderingContext2D
    title: HTMLElement

    mask: any
    stackOutside: HTMLElement | null
    stackWiresSvg: SVGElement | null

    bounding: {
      left: number
      top: number
      width: number
      height: number
    }
    letters: any[]
    works: any[]
    points: any[]
    pointsByLevel: any[][]

    tl: gsap.core.Timeline
    animationProgress: number
    pointsProgress: number
    last: {
      animationProgress: number
      pointsProgress: number
    }
    scrollProgress: number
    smoothScrollProgress: number
    state: 0
    speed: number
    isPaused: boolean

    constructor() {
      this.el = document.querySelector('.s-work')
      this.container = this.el.querySelector('.js-container')
      this.ruler = this.el.querySelector('.js-ruler')
      this.scene = this.container.querySelector('.js-scene')
      this.canvas = this.container.querySelector('.js-canvas')
      this.ctx = this.canvas.getContext('2d')
      this.title = this.container.querySelector('.js-title')

      this.mask = {
        width: 0,
        height: 0,
        maxScale: 1,
        el: this.el.querySelector('.js-mask'),
        svg: this.el.querySelector('.js-mask-svg'),
        pathOuter: this.el.querySelector('.js-mask-path-outer'),
        pathInner: this.el.querySelector('.js-mask-path-inner'),
      }

      this.stackOutside = this.el.querySelector('.js-stack-outside')
      this.stackWiresSvg = this.el.querySelector('.js-stack-wires')

      this.letters = []
      this.title.querySelectorAll('.js-letter').forEach((_letter) => {
        const letter = {
          el: _letter,
          char: (_letter.textContent || '').trim(),
          ghosts: [],
        }

        this.letters.push(letter)
      })

      this.works = []
      this.container.querySelectorAll('.js-work').forEach((_work) => {
        this.works.push({ el: _work })
      })

      this.points = []
      this.pointsByLevel = [[], [], [], [], [], []]

      this.scrollProgress = 0
      this.smoothScrollProgress = 0
      this.last = {
        animationProgress: -1,
        pointsProgress: -1,
      }

      this.isPaused = true

      if (document.readyState === 'complete') {
        Ticker.nextTick(this.init, this)
      } else {
        Emitter.once('siteLoaded', this.init, this)
      }
    }

    init() {
      this.setCtxStyle()
      this.setSize()
      this.setMask()
      this.setLetters()
      this.drawStackWires()
      this.setPoints()
      this.setWorks()
      this.setTimeline()
      this.drawPoints()

      this.initEntranceAnimation()
      this.initAmbientMotion()
      this.bindNodeHovers()

      this.bindEvents()

      if ('fonts' in document) {
        document.fonts.ready.then(() => {
          this.setLetters()
          this.drawStackWires()
        })
      }
    }

    bindEvents() {
      Emitter.on('contrastchange', this.setCtxStyle, this)
      Emitter.on('resize', this.onResize, this)
      Emitter.on('updateViewport', this.onUpdateViewport, this)

      this.el.addEventListener('intersect', this.onIntersect.bind(this), {
        passive: true,
      })
    }

    onUpdateViewport() {
      this.setSize()
      this.setMask()
      this.setLetters()
      this.drawStackWires()
      this.setPoints()
      this.setWorks()
      this.setTimeline()
      this.drawPoints()
    }

    onResize(widthChanged) {
      if (widthChanged) {
        this.setCtxStyle()
        this.setSize()
        this.setMask()
        this.setLetters()
        this.drawStackWires()
        this.setPoints()
        this.setWorks()
        this.setTimeline()
      }
    }

    onIntersect(e) {
      this.isPaused = !e.detail.isIntersecting

      if (this.isPaused) {
        Emitter.off('tick', this.tick, this)
      } else {
        Emitter.on('tick', this.tick, this)
      }
    }

    setCtxStyle() {
      const color = getComputedStyle(this.el).getPropertyValue('--color-primary')
      Ticker.nextTick(() => {
        this.ctx.strokeStyle = color
      })
    }

    setSize() {
      this.el.style.setProperty('--height', this.works.length * 50 + 'lvh')

      const bounding = this.container.getBoundingClientRect()

      this.bounding = {
        left: bounding.left,
        top: bounding.top,
        width: window.safeWidth,
        height: window.safeHeight,
      }

      this.canvas.width = this.bounding.width
      this.canvas.height = this.bounding.height

      this.speed = Math.hypot(this.bounding.width, this.bounding.height) * 4
    }

    setMask() {
      const { mask } = this

      const width = mask.el.clientWidth
      const height = mask.el.clientHeight

      mask.width = width
      mask.height = height

      mask.svg.style.width = mask.width + 'px'
      mask.svg.style.height = mask.height + 'px'

      const elBounding = this.el.getBoundingClientRect()
      const rulerBounding = this.ruler.getBoundingClientRect()
      const rulerWidth = rulerBounding.width
      const rulerHeight = rulerBounding.height
      const offsetX = rulerBounding.left - elBounding.left
      const offsetY = rulerBounding.top - elBounding.top

      const dOuter = `M -1 0 L ${width + 2} 0 L ${width + 2} ${height} L -1 ${height} Z`

      const corners = {
        tl: { x: offsetX, y: offsetY },
        tr: { x: offsetX + rulerWidth, y: offsetY },
        br: { x: offsetX + rulerWidth, y: offsetY + rulerHeight },
        bl: { x: offsetX, y: offsetY + rulerHeight },
      }

      let size = (corners.tr.x - corners.tl.x) / 2

      mask.maxScale = window.safeWidth / size

      let dInner = `M ${corners.tl.x} ${corners.tl.y + size} A ${size} ${size} 0 0 1 ${corners.tr.x} ${corners.tr.y + size} L ${corners.br.x} ${corners.br.y - size} A ${size} ${size} 0 0 1 ${corners.bl.x} ${corners.bl.y - size} Z`
      const linesClip = `${dOuter} ${dInner}`

      mask.pathOuter.setAttribute('d', `${dOuter} ${dInner}`)

      const thickness = window.safeWidth > 767 ? 16 : 8
      corners.tl.x += thickness
      corners.tl.y += thickness
      corners.tr.x -= thickness
      corners.tr.y += thickness
      corners.br.x -= thickness
      corners.br.y -= thickness
      corners.bl.x += thickness
      corners.bl.y -= thickness

      size = (corners.tr.x - corners.tl.x) / 2

      dInner = `M ${corners.tl.x} ${corners.tl.y + size} A ${size} ${size} 0 0 1 ${corners.tr.x} ${corners.tr.y + size} L ${corners.br.x} ${corners.br.y - size} A ${size} ${size} 0 0 1 ${corners.bl.x} ${corners.bl.y - size} Z`

      mask.pathInner.setAttribute('d', `${dOuter} ${dInner}`)
    }

    drawStackWires() {
      if (!this.stackWiresSvg || !this.ruler) return
      const isMobile = window.safeWidth <= 767
      if (isMobile) {
        this.stackWiresSvg.innerHTML = ''
        return
      }

      const maskOuter = (this.el.querySelector('.s__mask-outer') as HTMLElement) || this.el
      const maskRect = maskOuter.getBoundingClientRect()
      const rulerRect = this.ruler.getBoundingClientRect()
      const rulerWidth = rulerRect.width
      const rulerHeight = rulerRect.height
      const offsetX = rulerRect.left - maskRect.left
      const offsetY = rulerRect.top - maskRect.top
      const centerX = offsetX + rulerWidth / 2
      const radius = rulerWidth / 2

      const w = maskRect.width || window.safeWidth || window.innerWidth
      const h = maskRect.height || window.safeHeight || window.innerHeight
      this.stackWiresSvg.setAttribute('viewBox', `0 0 ${w} ${h}`)
      this.stackWiresSvg.style.width = w + 'px'
      this.stackWiresSvg.style.height = h + 'px'

      let svgContent = ''

      // Top vertical stem from capsule top apex with crosshair tick & tech markings
      const topApexY = offsetY
      const stemTopEndY = topApexY - 34
      svgContent += `
        <g class="s__stem-group s__stem-group--top">
          <line x1="${centerX.toFixed(1)}" y1="${topApexY.toFixed(1)}" x2="${centerX.toFixed(1)}" y2="${stemTopEndY.toFixed(1)}" stroke="#246b45" stroke-width="1.5" stroke-linecap="round" />
          <line x1="${(centerX - 6).toFixed(1)}" y1="${(topApexY - 14).toFixed(1)}" x2="${(centerX + 6).toFixed(1)}" y2="${(topApexY - 14).toFixed(1)}" stroke="#246b45" stroke-width="1.2" stroke-linecap="round" />
          <line x1="${(centerX - 3.5).toFixed(1)}" y1="${(topApexY - 24).toFixed(1)}" x2="${(centerX + 3.5).toFixed(1)}" y2="${(topApexY - 24).toFixed(1)}" stroke="#246b45" stroke-width="1" stroke-linecap="round" />
          <circle cx="${centerX.toFixed(1)}" cy="${stemTopEndY.toFixed(1)}" r="2.8" fill="#39e75f" />
        </g>`

      // Bottom vertical stem from capsule bottom apex with crosshair tick & tech markings
      const botApexY = offsetY + rulerHeight
      const stemBotEndY = botApexY + 34
      svgContent += `
        <g class="s__stem-group s__stem-group--bot">
          <line x1="${centerX.toFixed(1)}" y1="${botApexY.toFixed(1)}" x2="${centerX.toFixed(1)}" y2="${stemBotEndY.toFixed(1)}" stroke="#246b45" stroke-width="1.5" stroke-linecap="round" />
          <line x1="${(centerX - 6).toFixed(1)}" y1="${(botApexY + 14).toFixed(1)}" x2="${(centerX + 6).toFixed(1)}" y2="${(botApexY + 14).toFixed(1)}" stroke="#246b45" stroke-width="1.2" stroke-linecap="round" />
          <line x1="${(centerX - 3.5).toFixed(1)}" y1="${(botApexY + 24).toFixed(1)}" x2="${(centerX + 3.5).toFixed(1)}" y2="${(botApexY + 24).toFixed(1)}" stroke="#246b45" stroke-width="1" stroke-linecap="round" />
          <circle cx="${centerX.toFixed(1)}" cy="${stemBotEndY.toFixed(1)}" r="2.8" fill="#39e75f" />
        </g>`

      // Strict capsule outer rim calculation: terminates ONLY at the outer border of the pill
      const getCapsuleBorderX = (y: number, isLeft: boolean) => {
        const topArcCenterY = offsetY + radius
        const botArcCenterY = offsetY + rulerHeight - radius

        if (y < topArcCenterY) {
          // Inside top semi-circle cap
          const dy = topArcCenterY - y
          const safeR = Math.max(0, radius * radius - dy * dy)
          const dx = Math.sqrt(safeR)
          return isLeft ? (centerX - dx) : (centerX + dx)
        } else if (y > botArcCenterY) {
          // Inside bottom semi-circle cap
          const dy = y - botArcCenterY
          const safeR = Math.max(0, radius * radius - dy * dy)
          const dx = Math.sqrt(safeR)
          return isLeft ? (centerX - dx) : (centerX + dx)
        } else {
          // Along straight vertical sides
          return isLeft ? offsetX : (offsetX + rulerWidth)
        }
      }

      // 6 Left Nodes (Every single tech stack item connected one by one to outer capsule rim)
      const leftWireConfigs = [
        { id: 'kubernetes', jogOffset: -12, code: 'K8S//SYS' },
        { id: 'docker-left', jogOffset: 14, code: 'DCK//CTR' },
        { id: 'linux', jogOffset: -14, code: 'TUX//OS' },
        { id: 'kali', jogOffset: 14, code: 'KLI//NET' },
        { id: 'konflux', jogOffset: -14, code: 'KFX//BLD' },
        { id: 'cybersec', jogOffset: 12, code: 'SEC//DEF' },
      ]

      leftWireConfigs.forEach((cfg) => {
        const nodeEl = this.el.querySelector(`.js-stack-left .js-stack-node[data-id="${cfg.id}"]`)
        if (!nodeEl) return
        const card = nodeEl.querySelector('.s__stack-card') || nodeEl
        const nRect = card.getBoundingClientRect()
        const startX = nRect.right - maskRect.left + 5
        const startY = nRect.top - maskRect.top + nRect.height / 2

        // Determine target Y on capsule outer rim with intentional 45-degree thunder jog
        const rawTargetY = startY + cfg.jogOffset
        const targetY = Math.max(offsetY + 14, Math.min(offsetY + rulerHeight - 14, rawTargetY))
        const targetX = getCapsuleBorderX(targetY, true)

        const totalSpan = targetX - startX
        if (totalSpan <= 10) return

        const absDy = Math.abs(targetY - startY)
        let pathD = ''
        let p1X = startX + totalSpan * 0.5
        let p2X = p1X

        if (absDy < 2) {
          pathD = `M ${startX.toFixed(1)} ${startY.toFixed(1)} L ${targetX.toFixed(1)} ${startY.toFixed(1)}`
        } else {
          // Pure 45-degree angled thunder jog in the center
          const jogWidth = absDy
          const midX = startX + totalSpan * 0.5
          p1X = Math.max(startX + 12, Math.min(targetX - jogWidth - 12, midX - jogWidth * 0.5))
          p2X = p1X + jogWidth

          pathD = `M ${startX.toFixed(1)} ${startY.toFixed(1)} L ${p1X.toFixed(1)} ${startY.toFixed(1)} L ${p2X.toFixed(1)} ${targetY.toFixed(1)} L ${targetX.toFixed(1)} ${targetY.toFixed(1)}`
        }

        const codeX = startX + 10
        const codeY = startY - 5

        svgContent += `
          <g class="s__wire-group js-wire-group" data-node="${cfg.id}">
            <g class="s__start-pad">
              <circle cx="${startX.toFixed(1)}" cy="${startY.toFixed(1)}" r="3.8" fill="none" stroke="#246b45" stroke-width="0.8" opacity="0.5" />
              <circle class="s__wire-start-dot" cx="${startX.toFixed(1)}" cy="${startY.toFixed(1)}" r="2" fill="#246b45" />
            </g>
            <path class="s__wire-glow js-wire-glow" d="${pathD}" fill="none" stroke="#39e75f" stroke-width="3" opacity="0.12" stroke-linecap="round" stroke-linejoin="round" />
            <path class="s__wire-path js-wire-path" d="${pathD}" fill="none" stroke="#246b45" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="${p1X.toFixed(1)}" cy="${startY.toFixed(1)}" r="1.4" fill="#246b45" opacity="0.6" />
            <circle cx="${p2X.toFixed(1)}" cy="${targetY.toFixed(1)}" r="1.4" fill="#246b45" opacity="0.6" />
            <text class="s__wire-code" x="${codeX.toFixed(1)}" y="${codeY.toFixed(1)}" text-anchor="start">${cfg.code}</text>
            <g class="s__terminal-pad js-terminal-pad">
              <circle class="s__pad-halo js-pad-halo" cx="${targetX.toFixed(1)}" cy="${targetY.toFixed(1)}" r="5.5" fill="none" stroke="#246b45" stroke-width="1" opacity="0.6" />
              <circle class="s__wire-dot js-wire-dot" cx="${targetX.toFixed(1)}" cy="${targetY.toFixed(1)}" r="2.8" fill="#246b45" />
            </g>
            <circle class="s__wire-signal js-wire-signal" r="2.5" fill="#39e75f" opacity="0" cx="${startX.toFixed(1)}" cy="${startY.toFixed(1)}" />
          </g>`
      })

      // 5 Right Nodes (Every single tech stack item connected one by one to outer capsule rim)
      const rightWireConfigs = [
        { id: 'mern', jogOffset: -12, code: 'MRN//API' },
        { id: 'go', jogOffset: 14, code: 'GO//ASY' },
        { id: 'figma', jogOffset: -14, code: 'FGM//VEC' },
        { id: 'react', jogOffset: 14, code: 'RCT//DOM' },
        { id: 'docker-right', jogOffset: 12, code: 'DCK//OPS' },
      ]

      rightWireConfigs.forEach((cfg) => {
        const nodeEl = this.el.querySelector(`.js-stack-right .js-stack-node[data-id="${cfg.id}"]`)
        if (!nodeEl) return
        const card = nodeEl.querySelector('.s__stack-card') || nodeEl
        const nRect = card.getBoundingClientRect()
        const startX = nRect.left - maskRect.left - 5
        const startY = nRect.top - maskRect.top + nRect.height / 2

        // Determine target Y on capsule outer rim with intentional 45-degree thunder jog
        const rawTargetY = startY + cfg.jogOffset
        const targetY = Math.max(offsetY + 14, Math.min(offsetY + rulerHeight - 14, rawTargetY))
        const targetX = getCapsuleBorderX(targetY, false)

        const totalSpan = startX - targetX
        if (totalSpan <= 10) return

        const absDy = Math.abs(targetY - startY)
        let pathD = ''
        let p1X = startX - totalSpan * 0.5
        let p2X = p1X

        if (absDy < 2) {
          pathD = `M ${startX.toFixed(1)} ${startY.toFixed(1)} L ${targetX.toFixed(1)} ${startY.toFixed(1)}`
        } else {
          // Pure 45-degree angled thunder jog in the center
          const jogWidth = absDy
          const midX = startX - totalSpan * 0.5
          p1X = Math.min(startX - 12, Math.max(targetX + jogWidth + 12, midX + jogWidth * 0.5))
          p2X = p1X - jogWidth

          pathD = `M ${startX.toFixed(1)} ${startY.toFixed(1)} L ${p1X.toFixed(1)} ${startY.toFixed(1)} L ${p2X.toFixed(1)} ${targetY.toFixed(1)} L ${targetX.toFixed(1)} ${targetY.toFixed(1)}`
        }

        const codeX = startX - 10
        const codeY = startY - 5

        svgContent += `
          <g class="s__wire-group js-wire-group" data-node="${cfg.id}">
            <g class="s__start-pad">
              <circle cx="${startX.toFixed(1)}" cy="${startY.toFixed(1)}" r="3.8" fill="none" stroke="#246b45" stroke-width="0.8" opacity="0.5" />
              <circle class="s__wire-start-dot" cx="${startX.toFixed(1)}" cy="${startY.toFixed(1)}" r="2" fill="#246b45" />
            </g>
            <path class="s__wire-glow js-wire-glow" d="${pathD}" fill="none" stroke="#39e75f" stroke-width="3" opacity="0.12" stroke-linecap="round" stroke-linejoin="round" />
            <path class="s__wire-path js-wire-path" d="${pathD}" fill="none" stroke="#246b45" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="${p1X.toFixed(1)}" cy="${startY.toFixed(1)}" r="1.4" fill="#246b45" opacity="0.6" />
            <circle cx="${p2X.toFixed(1)}" cy="${targetY.toFixed(1)}" r="1.4" fill="#246b45" opacity="0.6" />
            <text class="s__wire-code" x="${codeX.toFixed(1)}" y="${codeY.toFixed(1)}" text-anchor="end">${cfg.code}</text>
            <g class="s__terminal-pad js-terminal-pad">
              <circle class="s__pad-halo js-pad-halo" cx="${targetX.toFixed(1)}" cy="${targetY.toFixed(1)}" r="5.5" fill="none" stroke="#246b45" stroke-width="1" opacity="0.6" />
              <circle class="s__wire-dot js-wire-dot" cx="${targetX.toFixed(1)}" cy="${targetY.toFixed(1)}" r="2.8" fill="#246b45" />
            </g>
            <circle class="s__wire-signal js-wire-signal" r="2.5" fill="#39e75f" opacity="0" cx="${startX.toFixed(1)}" cy="${startY.toFixed(1)}" />
          </g>`
      })

      this.stackWiresSvg.innerHTML = svgContent
      this.bindNodeHovers()
    }

    initEntranceAnimation() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        return
      }

      const isMobile = window.safeWidth <= 767
      if (isMobile) return

      const wirePaths = this.stackWiresSvg ? Array.from(this.stackWiresSvg.querySelectorAll('.js-wire-path, .js-wire-glow')) : []
      const wireDots = this.stackWiresSvg ? Array.from(this.stackWiresSvg.querySelectorAll('.js-wire-dot, .s__wire-start-dot, .js-pad-halo, .s__wire-code')) : []

      wirePaths.forEach((path: any) => {
        const len = path.getTotalLength()
        path.style.strokeDasharray = `${len}`
        path.style.strokeDashoffset = `${len}`
      })

      const entranceTl = gsap.timeline({
        scrollTrigger: {
          trigger: this.el,
          start: 'top 80%',
          once: true,
        },
      })

      // 1. Fade in header metadata with subtle upward movement
      const metaEls = this.stackOutside?.querySelectorAll('.js-stack-top, .js-stack-stem-top, .js-stack-bot')
      if (metaEls && metaEls.length) {
        entranceTl.fromTo(metaEls, { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.75, ease: 'power2.out' }, 0)
      }

      // 2. Reveal the WORK capsule with restrained scale and opacity transition
      entranceTl.fromTo(
        this.mask.el,
        { scale: 0.94, opacity: 0 },
        { scale: 1, opacity: 1, duration: 0.85, ease: 'power3.out' },
        0.1
      )

      // 3. Reveal W, O, R, and K sequentially with small stagger
      this.letters.forEach((letter, lIdx) => {
        const ghostEls = letter.ghosts.map((g: any) => g.el)
        entranceTl.fromTo(
          ghostEls,
          { opacity: 0, y: 24, scale: 0.96 },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.65,
            ease: 'power3.out',
          },
          0.2 + lIdx * 0.12
        )
      })

      // 4. Draw SVG connector lines outward from capsule using path-length animation
      if (wirePaths.length) {
        entranceTl.to(
          wirePaths,
          { strokeDashoffset: 0, duration: 0.9, stagger: 0.08, ease: 'power2.out' },
          0.45
        )
      }
      if (wireDots.length) {
        entranceTl.fromTo(
          wireDots,
          { scale: 0, opacity: 0 },
          { scale: 1, opacity: 1, duration: 0.35, stagger: 0.06, ease: 'back.out(2)', transformOrigin: 'center center' },
          0.6
        )
      }

      // 5. Reveal left and right technology icons in alternating, staggered sequence
      const leftNodes = Array.from(this.el.querySelectorAll('.js-stack-left .js-stack-node'))
      const rightNodes = Array.from(this.el.querySelectorAll('.js-stack-right .js-stack-node'))
      const maxNodes = Math.max(leftNodes.length, rightNodes.length)
      const alternatingNodes: Element[] = []

      for (let i = 0; i < maxNodes; i++) {
        if (leftNodes[i]) alternatingNodes.push(leftNodes[i])
        if (rightNodes[i]) alternatingNodes.push(rightNodes[i])
      }

      alternatingNodes.forEach((node, idx) => {
        const icon = node.querySelector('.s__stack-icon-wrap') || node
        const label = node.querySelector('.s__stack-label')
        const delay = 0.45 + idx * 0.06

        entranceTl.fromTo(
          icon,
          { scale: 0.75, opacity: 0 },
          { scale: 1, opacity: 1, duration: 0.45, ease: 'back.out(1.5)' },
          delay
        )

        // Reveal each icon label just after its corresponding icon
        if (label) {
          entranceTl.fromTo(
            label,
            { opacity: 0, y: 4 },
            { opacity: 1, y: 0, duration: 0.35, ease: 'power2.out' },
            delay + 0.1
          )
        }
      })
    }

    initAmbientMotion() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        return
      }

      // Pulse cybernetic data packets along connector lines
      const pulseSignals = () => {
        if (this.isPaused || !this.stackWiresSvg) return
        const wireGroups = Array.from(this.stackWiresSvg.querySelectorAll('.js-wire-group'))
        if (!wireGroups.length) return

        const count = Math.min(3, wireGroups.length)
        const shuffled = [...wireGroups].sort(() => 0.5 - Math.random()).slice(0, count)

        shuffled.forEach((group, i) => {
          const path = group.querySelector('.js-wire-path') as SVGPathElement | null
          const signalDot = group.querySelector('.js-wire-signal') as SVGCircleElement | null
          const padHalo = group.querySelector('.js-pad-halo') as SVGCircleElement | null
          if (!path || !signalDot) return

          const len = path.getTotalLength()
          const progressObj = { p: 0 }

          gsap.delayedCall(i * 0.28, () => {
            gsap.fromTo(
              signalDot,
              { opacity: 0 },
              {
                opacity: 1,
                duration: 0.15,
                onComplete: () => {
                  gsap.to(progressObj, {
                    p: 1,
                    duration: 0.95 + Math.random() * 0.3,
                    ease: 'power1.inOut',
                    onUpdate: () => {
                      const pt = path.getPointAtLength(progressObj.p * len)
                      signalDot.setAttribute('cx', pt.x.toFixed(1))
                      signalDot.setAttribute('cy', pt.y.toFixed(1))
                    },
                    onComplete: () => {
                      gsap.to(signalDot, { opacity: 0, duration: 0.2 })
                      if (padHalo) {
                        gsap.fromTo(
                          padHalo,
                          { opacity: 1, stroke: '#39e75f', strokeWidth: 1.8 },
                          { opacity: 0.6, stroke: '#246b45', strokeWidth: 1, duration: 0.55, ease: 'power2.out' }
                        )
                      }
                    },
                  })
                },
              }
            )
          })
        })
      }

      setInterval(pulseSignals, 1800)
      pulseSignals()
    }

    bindNodeHovers() {
      const nodes = this.el.querySelectorAll('.js-stack-node')
      nodes.forEach((node) => {
        const id = (node as HTMLElement).dataset.id
        node.addEventListener('mouseenter', () => {
          const wireGroup = this.stackWiresSvg?.querySelector(`.js-wire-group[data-node="${id}"]`)
          if (wireGroup) wireGroup.classList.add('is-active')
        })
        node.addEventListener('mouseleave', () => {
          const wireGroup = this.stackWiresSvg?.querySelector(`.js-wire-group[data-node="${id}"]`)
          if (wireGroup) wireGroup.classList.remove('is-active')
        })
      })

      const wireGroups = this.stackWiresSvg?.querySelectorAll('.js-wire-group') || []
      wireGroups.forEach((group) => {
        const nodeId = (group as HTMLElement).dataset.node
        group.addEventListener('mouseenter', () => {
          group.classList.add('is-active')
          const node = this.el.querySelector(`.js-stack-node[data-id="${nodeId}"]`)
          node?.classList.add('is-hovered')
        })
        group.addEventListener('mouseleave', () => {
          group.classList.remove('is-active')
          const node = this.el.querySelector(`.js-stack-node[data-id="${nodeId}"]`)
          node?.classList.remove('is-hovered')
        })
      })
    }

    setLetters() {
      const { letters, scene } = this

      letters.forEach((letter, j) => {
        letter.ghosts.forEach((ghost) => {
          ghost.el.remove()
        })
        letter.ghosts = []

        const bounding = letter.el.getBoundingClientRect()

        letter.width = bounding.width
        letter.height = bounding.height
        letter.top = bounding.top - this.bounding.top
        letter.left = bounding.left

        letter.freq = 1 + Math.random()

        const multiplier = window.safeWidth > 767 ? 0.75 : 0.5

        letter.total = Math.round((this.bounding.width / letter.width) * multiplier) + 2

        const char = letter.char || (letter.el.textContent || '').trim()

        for (let i = 0; i < letter.total; i++) {
          const el = document.createElement('span')
          el.classList.add('s__scene__letter')
          el.classList.add('js-letter')

          el.textContent = char
          el.dataset.letter = char

          scene.appendChild(el)

          const ghost = {
            el,
            x: letter.left,
            y: letter.top,
            z: Math.random() * 100,
            i: i - letter.total * 0.5,
            p: (i / letter.total - 0.5) * 2,
            ap: Math.abs(i / letter.total - 0.5) * 2,
            mx: 0,
            my: 0,
          }

          el.style.top = ghost.y + 'px'
          el.style.left = ghost.x + 'px'

          el.style.zIndex = '0'

          el.style.setProperty('--ix', String(ghost.i))
          el.style.setProperty('--iy', String(((j + 1) / (letters.length + 1) - 0.5) * 2))

          el.style.setProperty('--ap', String(ghost.ap))
          el.style.setProperty('--p', String(ghost.p))

          letter.ghosts.push(ghost)
        }
      })
    }

    setWorks() {
      const { works } = this

      works.forEach((work, i) => {
        const el = work.el
        // Larger baseline scale for OSS cards and highlighted projects
        const isHero = el.classList.contains('s__scene__work--card') ||
                       el.classList.contains('s__scene__work--oss') ||
                       el.classList.contains('s__scene__work--image')
        if (isHero) {
          el.style.setProperty('--size', String(0.72 + Math.random() * 0.24))
        } else {
          el.style.setProperty('--size', String(0.5 + Math.random() * 0.5))
        }
        el.style.setProperty('--y', String((0.3 + Math.random() * 0.5) * (i % 2 ? -1 : 1)))
      })
    }

    setTimeline() {
      const { el, container, works, scene, mask } = this

      const worksEl = works.map((work) => work.el)
      const isMobile = window.safeWidth <= 767

      let { tl } = this
      if (tl) tl.kill()

      tl = gsap.timeline({
        scrollTrigger: {
          trigger: el,
          start: 'top 25%',
          end: 'bottom 75%',
          scrub: 1,
        },
        onUpdate: () => {
          scene.style.setProperty('--state', String(this.state))
        },
      })

      const wirePaths = this.stackWiresSvg ? Array.from(this.stackWiresSvg.querySelectorAll('.js-wire-path, .js-wire-glow')) : []
      const wireDots = this.stackWiresSvg ? Array.from(this.stackWiresSvg.querySelectorAll('.js-wire-dot, .s__wire-start-dot, .js-pad-halo, .s__wire-code')) : []
      const leftCol = this.el.querySelector('.js-stack-left')
      const rightCol = this.el.querySelector('.js-stack-right')

      // Parallax on outside columns during initial scroll
      if (!isMobile) {
        if (leftCol) {
          tl.fromTo(leftCol, { y: 0 }, { y: -16, duration: 0.75, ease: 'none' }, 0)
        }
        if (rightCol) {
          tl.fromTo(rightCol, { y: 0 }, { y: 16, duration: 0.75, ease: 'none' }, 0)
        }
      }

      // Smoothly retract wires and fade outside tech stack
      if (!isMobile) {
        if (leftCol) {
          tl.to(leftCol, { y: -38, duration: 0.45, ease: 'power1.in' }, 0.75)
        }
        if (rightCol) {
          tl.to(rightCol, { y: 38, duration: 0.45, ease: 'power1.in' }, 0.75)
        }

        if (wirePaths.length) {
          wirePaths.forEach((path: any) => {
            const len = path.getTotalLength ? path.getTotalLength() : 300
            tl.to(path, { strokeDashoffset: len, duration: 0.4, ease: 'power2.in' }, 0.75)
          })
        }
        if (wireDots.length) {
          tl.to(wireDots, { opacity: 0, scale: 0, duration: 0.35, ease: 'power1.in' }, 0.8)
        }
      }

      // Fade outside tech stack
      if (this.stackOutside) {
        tl.to(this.stackOutside, { opacity: 0, duration: 0.45, ease: 'power1.out' }, 0.8)
      }

      // Matrix canvas subtle dimming
      tl.fromTo(this.canvas, { opacity: 1 }, { opacity: 0.25, duration: 0.5, ease: 'power1.out' }, 0.85)

      // Expansion into Selected Projects
      tl.fromTo(mask.el, { scale: 1 }, { scale: mask.maxScale, duration: 0.8, ease: 'power4.in' }, 1.0)
      tl.fromTo(scene, { scale: 0.75 }, { scale: 1, duration: 0.8, ease: 'power3.in' }, 1.0)
      tl.fromTo(container, { clipPath: 'inset(0 1rem)' }, { clipPath: 'inset(0 0rem)', duration: 0.8, ease: 'power3.in' }, 1.0)
      tl.fromTo(this, { pointsProgress: 0 }, { pointsProgress: 1, duration: 1.0, ease: 'power4.inOut' }, 1.0)
      tl.fromTo(this, { state: 0 }, { state: 1, duration: 0.8, ease: 'power4.in' }, 1.0)

      // Selected Project Cards
      tl.fromTo(
        worksEl,
        { attr: { progress: 1 } },
        {
          attr: { progress: -1 },
          ease: 'slow(0.15, 0.6)',
          stagger: 0.25,
        },
        1.75
      )

      tl.fromTo(
        this,
        { animationProgress: 0 },
        { animationProgress: 10000, duration: tl.totalDuration() - 1.75, ease: 'power1.out' },
        1.75
      )

      // Exit transition closing back at the end of the section
      tl.fromTo(this, { state: 1 }, { state: 0, duration: 0.75, ease: 'power4.inOut', immediateRender: false }, '-=1')
      tl.fromTo(mask.el, { scale: mask.maxScale }, { scale: 1, duration: 0.75, ease: 'power4.inOut', immediateRender: false }, '-=1')
      tl.fromTo(scene, { scale: 1 }, { scale: 0.75, duration: 0.75, ease: 'power3.inOut', immediateRender: false }, '-=1')
      tl.fromTo(container, { clipPath: 'inset(0 0rem)' }, { clipPath: 'inset(0 1rem)', duration: 0.75, ease: 'power3.inOut', immediateRender: false }, '-=1')
      tl.fromTo(this, { pointsProgress: 1 }, { pointsProgress: 0, duration: 1, ease: 'power4.inOut' }, '-=1')
    }

    moveLetters() {
      const { speed, letters, animationProgress } = this

      letters.forEach((letter) => {
        const letterSpeed = speed * letter.freq
        letter.ghosts.forEach((ghost, index) => {
          let progress =
            (((animationProgress % letterSpeed) / letterSpeed +
              index / letter.total) %
              1) /
              0.7 -
            0.15

          ghost.el.style.setProperty('--progress', String(progress))
        })
      })
    }

    getContribLevel(col: number, row: number): number {
      const n = Math.abs(Math.sin(col * 127.1 + row * 311.7) * 43758.5453) % 1
      const day = row % 7
      const isWeekend = day === 5 || day === 6

      if ((col % 16 === 4 && row % 7 === 4) || (col % 27 === 11 && row % 7 === 3)) return 5
      if ((col % 11 === 0 && (row % 7 === 1 || row % 7 === 3)) || (col % 15 === 7 && row % 7 === 2)) return 4

      const activeThreshold = isWeekend ? 0.52 : 0.20
      if (n < activeThreshold) return 0

      const tier = (n - activeThreshold) / (1 - activeThreshold)
      if (tier > 0.82) return 4
      if (tier > 0.52) return 3
      if (tier > 0.22) return 2
      return 1
    }

    setPoints() {
      const { bounding } = this

      this.points = []
      this.pointsByLevel = [[], [], [], [], [], []]

      const isMobile = window.safeWidth <= 767
      const gap = isMobile ? 20 : 25
      const cellSize = isMobile ? 12 : 14
      const cellRadius = isMobile ? 2.5 : 3

      const cols = Math.ceil((bounding.width * 1.2) / gap)
      const rows = Math.ceil((bounding.height * 1.2) / gap)

      const offsetX = (bounding.width - cols * gap) * 0.5
      const offsetY = (bounding.height - rows * gap) * 0.5

      const hWidth = bounding.width * 0.5
      const hHeight = bounding.height * 0.5

      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          const x = i * gap + offsetX
          const y = j * gap + offsetY

          const dx = hWidth - x
          const dy = hHeight - y

          const level = this.getContribLevel(i, j)

          const pt = { x, y, dx, dy, m: Math.random(), flowX: 0, flowY: 0, level, cellSize, cellRadius }

          this.points.push(pt)
          this.pointsByLevel[level].push(pt)
        }
      }
    }

    ambientTime = 0

    movePoints() {
      const { points, animationProgress } = this
      const isMobile = window.safeWidth <= 767
      const gap = isMobile ? 20 : 25
      const flow = ((animationProgress + this.ambientTime) * -0.06) % gap
      const flowY = (this.ambientTime * -0.03) % gap

      for (let i = 0; i < points.length; i++) {
        points[i].flowX = flow
        points[i].flowY = flowY
      }
    }

    drawPoints() {
      const { bounding, ctx, pointsProgress, animationProgress, last, pointsByLevel } = this

      const rAnimationProgress = Math.round(animationProgress * 50) / 50
      const rPointsProgress = Math.round(pointsProgress * 100) / 100

      // When fully expanded into cards, freeze canvas rendering to conserve CPU/GPU
      if (rPointsProgress >= 0.98 && last.pointsProgress >= 0.98) return

      if (rPointsProgress === last.pointsProgress && rAnimationProgress === last.animationProgress) return

      ctx.clearRect(0, 0, bounding.width, bounding.height)

      const colors = [
        'rgba(255, 240, 235, 0.06)',
        '#0e4429',
        '#006d32',
        '#26a641',
        '#39d353',
        '#f59e0b',
      ]

      const factor = (1 - pointsProgress) * 0.2

      for (let lvl = 0; lvl < 6; lvl++) {
        const bucket = pointsByLevel[lvl]
        if (!bucket || bucket.length === 0) continue

        ctx.fillStyle = colors[lvl]

        ctx.beginPath()
        for (let k = 0; k < bucket.length; k++) {
          const pt = bucket[k]
          const x = pt.x + pt.dx * factor + pt.flowX
          const y = pt.y + pt.dy * factor + (pt.flowY || 0)

          if (ctx.roundRect) {
            ctx.roundRect(x, y, pt.cellSize, pt.cellSize, pt.cellRadius)
          } else {
            ctx.rect(x, y, pt.cellSize, pt.cellSize)
          }
        }
        ctx.fill()
      }

      ctx.shadowColor = 'transparent'
      ctx.shadowBlur = 0

      last.pointsProgress = rPointsProgress
      last.animationProgress = rAnimationProgress
    }

    tick() {
      this.ambientTime += 0.35
      this.scrollProgress =
        Math.max(Math.min(1, ScrollTrigger.positionInViewport(this.el, 'top')), 0) * -1 +
        (1 - Math.max(Math.min(1, ScrollTrigger.positionInViewport(this.el, 'bottom')), 0))
      this.smoothScrollProgress += (this.scrollProgress - this.smoothScrollProgress) * 0.1

      this.el.style.setProperty('--scroll-progress', String(this.scrollProgress))

      this.movePoints()
      this.moveLetters()

      this.drawPoints()
    }
  }

  new Section()
</script>

