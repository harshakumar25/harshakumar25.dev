---
import AWork from './AWork.astro'

// Curated real projects + OSS contribution dashboards.
// Each entry becomes a card in the WORK scene. Order is intentional:
// hero projects first, then OSS org dashboards.
const projects = [
  // ─── Real Projects ──────────────────────────────────────────
  {
    kind: 'image',
    title: 'ASRO : Autonomous Security Orchestrator',
    caption: '[SHIPPED] ASRO · Multi-Agent Pentest Platform',
    site: 'https://github.com/harshakumar25',
    image: '/images/asro.webp',
    tag: 'STEALTH / SECURITY',
    accent: '#00e5ff',
  },
  {
    kind: 'image',
    title: 'Ingredio : AI Ingredient Intelligence',
    caption: '[ML BUILD] Ingredio · 24h Sprint',
    site: 'https://ingredio.ai',
    image: '/images/ingredio.webp',
    tag: 'HIGH-IMPACT ML / 24H',
    accent: '#10b981',
  },
  {
    kind: 'image',
    title: 'Antrea NetMonitor : Live Packet Observability',
    caption: '[BUILT] Antrea NetMonitor · K8s Networking HUD',
    site: 'https://github.com/harshakumar25',
    image: '/images/antrea-netmonitor.webp',
    tag: 'CNCF / NETWORKING',
    accent: '#60a5fa',
  },
  {
    kind: 'image',
    title: 'AdvocateVox : AI Legal Intelligence',
    caption: '[BUILT] AdvocateVox · Case & Statute Search',
    site: 'https://github.com/harshakumar25/advocatevox',
    image: '/images/advocatevox.png',
    tag: 'LEGAL / AI',
    accent: '#c084fc',
  },
  {
    kind: 'image',
    title: 'bhnexura.com',
    caption: '[INTERN] bhnexura.com · BBA LLB College Portal',
    site: 'https://bhnexura.com',
    image: '/images/bhnexura.webp',
    tag: 'FULL-STACK · INTERN',
    accent: '#f472b6',
  },
  // ─── OSS Contribution Dashboards ────────────────────────────
  // User-provided logos and requested merged PRs featured first:
  {
    kind: 'oss',
    org: 'Konflux',
    orgTag: 'CNCF · Supply Chain',
    caption: '[OSS] Konflux · Top 2% Contributor',
    site: 'https://github.com/konflux-ci',
    logo: '/images/logos/konflux.png',
    accent: '#39e75f',
    status: 'ACTIVE',
    stats: [
      { k: 'PRs Merged',   v: '5'  },
      { k: 'Bugs Fixed',   v: '3'  },
      { k: 'Issues Filed', v: '20' },
      { k: 'Rank',         v: 'Top 2%' },
    ],
    signal: 'Tekton bundle resolver · Pipeline attestation',
  },
  {
    kind: 'oss',
    org: 'KubeStellar',
    orgTag: 'CNCF · Multi-Cluster',
    caption: '[OSS] KubeStellar · Merged PR #830',
    site: 'https://github.com/kubestellar/docs/pull/830',
    logo: '/images/logos/kubestellar.png',
    accent: '#38bdf8',
    status: 'PR MERGED',
    pr: {
      number: '#830',
      title: 'docs: Add WECS remote monitoring documentation (Fixes #2286)',
      url: 'https://github.com/kubestellar/docs/pull/830',
    },
    stats: [
      { k: 'PR Status',   v: 'MERGED' },
      { k: 'PR Number',   v: '#830' },
      { k: 'Fixes Issue', v: '#2286' },
      { k: 'Area',        v: 'WECS Docs' },
    ],
    signal: 'docs: Add WECS remote monitoring documentation (Fixes #2286)',
  },
  {
    kind: 'oss',
    org: 'Kyverno',
    orgTag: 'CNCF · Policy Engine',
    caption: '[OSS] Kyverno · Merged PR #15063',
    site: 'https://github.com/kyverno/kyverno/pull/15063',
    logo: '/images/logos/kyverno.svg',
    accent: '#c084fc',
    status: 'PR MERGED',
    pr: {
      number: '#15063',
      title: 'refactor: improve logging consistency across codebase',
      url: 'https://github.com/kyverno/kyverno/pull/15063',
    },
    stats: [
      { k: 'PR Status',   v: 'MERGED' },
      { k: 'PR Number',   v: '#15063' },
      { k: 'Bugs Fixed',  v: '1' },
      { k: 'Scope',       v: 'Engine' },
    ],
    signal: 'refactor: improve logging consistency across codebase',
  },
  {
    kind: 'oss',
    org: 'Kubernetes',
    orgTag: 'CNCF · Core',
    caption: '[OSS] Kubernetes · Upstream Contributor',
    site: 'https://github.com/kubernetes/kubernetes',
