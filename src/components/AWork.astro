---
const { caption, cssClass, image, index, site, total, kind, project } = Astro.props

const resolvedKind = kind || (image ? 'image' : 'card')
const mediaSrc = image

// Short random key for the index tag
const key = Math.random().toString(36).slice(2, 6) + '-' + index + '/' + total
const accent = (project && project.accent) || '#39e75f'
---

<a-work
  class={cssClass}
  data-kind={resolvedKind}
  data-is-image={resolvedKind === 'image' ? 'true' : 'false'}
  data-highlighted={project?.highlighted ? 'true' : 'false'}
  style={`--accent:${accent}`}>
  <div class="a__inner js-inner">
    <a href={site} target="_blank" rel="noopener noreferrer" class="a__link js-link">
      <div class="a__media-wrap js-media-wrap">
        {
          resolvedKind === 'image' && mediaSrc && (
            <div class={`a__img-viewport js-viewport ${project?.highlighted ? 'a__img-viewport--highlighted' : ''}`}>
              <img
                src={mediaSrc}
                alt={caption}
                class="a__img js-media-target js-img"
                loading="lazy"
                draggable="false"
              />

              {/* Viewport Top Bar */}
              <div class="a__view-topbar">
                <div class="a__view-top-left">
                  <span class="a__img-tag">{project?.tag}</span>
                  {project?.status && (
                    <span class="a__status-pill">
                      <span class="a__status-dot"></span>
                      <span>{project.status}</span>
                    </span>
                  )}
                </div>

                {project?.site && (
                  <span
                    class="a__repo-link-chip"
                    title={`View repository on GitHub`}
                  >
                    <svg class="a__gh-icon" viewBox="0 0 24 24" width="11" height="11" fill="currentColor">
                      <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                    </svg>
                    <span>{project.repoName || 'GITHUB REPO'} ↗</span>
                  </span>
                )}
              </div>

              {/* Gallery Switcher for Multi-Shot Projects (e.g. Veriqo) */}
              {project?.gallery && project.gallery.length > 1 && (
                <div class="a__gallery-bar js-gallery-bar">
                  {project.gallery.map((g: any, gIdx: number) => (
                    <button
                      type="button"
                      class={`a__gallery-btn js-gallery-btn ${gIdx === 0 ? 'is-active' : ''}`}
                      data-src={g.src}
                    >
                      <span class="a__gallery-btn-dot"></span>
                      <span>{g.label}</span>
                    </button>
                  ))}
                </div>
              )}

              {/* Deep Architecture HUD Overlay */}
              {project?.highlighted && (
                <div class="a__deep-scrim">
                  <div class="a__deep-content">
                    <div class="a__deep-meta">
                      <h3 class="a__deep-title">{project.title}</h3>
                      <p class="a__deep-lead">{project.lead}</p>
                    </div>

                    {project?.badges && (
                      <div class="a__deep-badges">
                        {project.badges.map((b: string) => (
                          <span class="a__deep-badge">› {b}</span>
                        ))}
                      </div>
                    )}

                    {project?.specs && (
                      <div class="a__deep-specs">
                        {project.specs.map((s: any) => (
                          <div class="a__deep-spec">
                            <span class="a__deep-spec-k">{s.k}</span>
                            <span class="a__deep-spec-v">{s.v}</span>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              )}
            </div>
          )
        }

        {
          resolvedKind === 'image' && !mediaSrc && (
            <div class="a__img-viewport a__img-viewport--placeholder">
              <div class="a__hero-card">
                <span class="a__hero-tag">{project?.tag || 'STEALTH / SECURITY'}</span>
                <h3 class="a__hero-title">{project?.title || caption}</h3>
                <p class="a__hero-lead">
                  Multi-agent offensive security orchestration : 103 attack playbooks across
                  a 16-phase autonomous research pipeline. Zero fake findings.
                </p>
                <ul class="a__hero-chips">
                  <li>RECON</li><li>ENUM</li><li>EXPLOIT</li><li>REPORT</li>
                </ul>
                <div class="a__hero-status">
                  <span class="a__hero-led"></span>
                  <span>PIPELINE // 16 PHASES ACTIVE</span>
                </div>
              </div>
            </div>
          )
        }

        {
          resolvedKind === 'card' && (
            <div class="a__img-viewport a__card-viewport">
              <div class="a__card">
                <div class="a__card-head">
                  <span class="a__card-tag">{project?.tag}</span>
                  <span class="a__card-dots">
                    <i></i><i></i><i></i>
                  </span>
                </div>
                <h3 class="a__card-title">{project?.title}</h3>
                <p class="a__card-lead">{project?.body?.lead}</p>
                {project?.body?.bullets && (
                  <ul class="a__card-bullets">
                    {project.body.bullets.map((b: string) => (
                      <li>› {b}</li>
                    ))}
                  </ul>
                )}
                {project?.body?.meta && (
                  <div class="a__card-meta">{project.body.meta}</div>
                )}
              </div>
            </div>
          )
        }

        {
          resolvedKind === 'oss' && (
            <div class="a__img-viewport a__oss-viewport">
              <div class="a__oss">
                <div class="a__oss-head">
                  <div class="a__oss-brand-wrap">
                    {project?.logo ? (
                      <div class="a__oss-logo-card">
                        <img
                          src={project.logo}
                          alt={project?.org || 'Open Source Project'}
                          class="a__oss-logo-img"
                          loading="lazy"
                        />
                      </div>
                    ) : (
                      <div class="a__oss-logo" aria-hidden="true">
                        <span class="a__oss-logo-glyph">{project?.org?.[0]}</span>
                        <span class="a__oss-logo-ring"></span>
                      </div>
                    )}
                    <div class="a__oss-id">
                      {!project?.logo && <h3 class="a__oss-org">{project?.org}</h3>}
                      <span class="a__oss-tag">{project?.orgTag}</span>
                      {project?.pr && (
                        <span class="a__oss-pr-badge" title={project.pr.title}>
                          <svg viewBox="0 0 16 16" width="10" height="10" fill="currentColor">
                            <path d="M7.177 3.073L9.573.677A.25.25 0 0110 .854v4.792a.25.25 0 01-.427.177L7.177 3.427a.25.25 0 010-.354zM3.75 2.5a.75.75 0 100 1.5.75.75 0 000-1.5zm-2.25.75a2.25 2.25 0 113 2.122v5.256a2.251 2.251 0 11-1.5 0V5.372A2.25 2.25 0 011.5 3.25zM11 2.5h-1V4h1a1 1 0 011 1v5.628a2.251 2.251 0 101.5 0V5A2.5 2.5 0 0011 2.5zm1 10.25a.75.75 0 111.5 0 .75.75 0 01-1.5 0zM3.75 12a.75.75 0 100 1.5.75.75 0 000-1.5z"/>
                          </svg>
                          <span>PR {project.pr.number} MERGED</span>
                        </span>
                      )}
                    </div>
                  </div>
                  <div class="a__oss-status">
                    <span class="a__oss-led"></span>
                    <span>{project?.status}</span>
                  </div>
                </div>

                <div class="a__oss-stats">
                  {project?.stats?.map((s: any) => (
                    <div class="a__oss-stat">
                      <span class="a__oss-stat-val">{s.v}</span>
                      <span class="a__oss-stat-key">{s.k}</span>
                    </div>
                  ))}
                </div>

                <div class="a__oss-signal">
                  <span class="a__oss-signal-bar"></span>
                  <span class="a__oss-signal-text">{project?.signal}</span>
                </div>
              </div>
            </div>
          )
        }
      </div>

      <div class="a__caption">
        <div class="a__caption__text">
          {caption}
        </div>

        <div class="a__caption__key">
          #{key}
        </div>
      </div>
    </a>
  </div>
</a-work>

<script>
  class AWork extends HTMLElement {
    static observedAttributes = ['progress']

    link: HTMLAnchorElement | null
    inner: HTMLElement | null
    media: HTMLElement | null
    isImage: boolean

    isPlaying: boolean
    isHovered: boolean
    rafId: number | null

    targetNormX: number
    targetNormY: number
    targetOffsetX: number
    targetOffsetY: number

    currentNormX: number
    currentNormY: number
    currentOffsetX: number
    currentOffsetY: number
    currentScale: number

    connectedCallback() {
      this.link = this.querySelector('a')
      this.inner = this.querySelector('.js-inner')
      this.media = this.querySelector('.js-media-target')
      this.isImage = this.getAttribute('data-is-image') === 'true'

      this.isPlaying = false
      this.isHovered = false
      this.rafId = null

      this.targetNormX = 0.5
      this.targetNormY = 0
      this.targetOffsetX = 0
      this.targetOffsetY = 0

      this.currentNormX = 0.5
      this.currentNormY = 0
      this.currentOffsetX = 0
      this.currentOffsetY = 0
      this.currentScale = 1

      if (this.link) {
        this.link.addEventListener('click', this.onClick.bind(this))
      }

      // Bind Gallery Switcher Buttons (e.g. Veriqo Multi-View)
      const galleryBtns = this.querySelectorAll('.js-gallery-btn')
      galleryBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault()
          e.stopPropagation()
          galleryBtns.forEach((b) => b.classList.remove('is-active'))
          btn.classList.add('is-active')
          const src = btn.getAttribute('data-src')
          const img = this.querySelector('.js-img') as HTMLImageElement
          if (img && src) {
            img.src = src
          }
        })
      })

      this.onMouseEnter = this.onMouseEnter.bind(this)
      this.onMouseMove = this.onMouseMove.bind(this)
      this.onMouseLeave = this.onMouseLeave.bind(this)
      this.tick = this.tick.bind(this)

      this.addEventListener('mouseenter', this.onMouseEnter)
      this.addEventListener('mousemove', this.onMouseMove)
      this.addEventListener('mouseleave', this.onMouseLeave)
    }

    disconnectedCallback() {
      if (this.rafId) {
        cancelAnimationFrame(this.rafId)
        this.rafId = null
      }
      this.removeEventListener('mouseenter', this.onMouseEnter)
      this.removeEventListener('mousemove', this.onMouseMove)
      this.removeEventListener('mouseleave', this.onMouseLeave)
    }

    attributeChangedCallback(name, oldValue, newValue) {
      if (name === 'progress') {
        this.style.setProperty('--progress', newValue)

        if (newValue === '1' || newValue === '-1') {
          if (this.isPlaying) this.outView()
        } else {
          if (!this.isPlaying) this.inView()
        }
      }
    }

    inView() {
      this.isPlaying = true
      this.classList.add('is-inview')
    }

    outView() {
      this.isPlaying = false
      this.classList.remove('is-inview')
    }

    onClick(event: MouseEvent) {
      if (this.link && this.link.href.includes('#')) {
        event.preventDefault()
        return false
      }
    }

    onMouseEnter(e: MouseEvent) {
      this.isHovered = true
      this.classList.add('is-hovered')
      this.style.zIndex = '9999'
      this.updateMousePos(e)
      this.startLoop()
    }

    onMouseMove(e: MouseEvent) {
      this.updateMousePos(e)
      this.startLoop()
    }

    onMouseLeave() {
      this.isHovered = false
      this.classList.remove('is-hovered')
      this.style.zIndex = ''
      this.targetNormX = 0.5
      this.targetNormY = 0
      this.targetOffsetX = 0
      this.targetOffsetY = 0
      this.startLoop()
    }

    updateMousePos(e: MouseEvent) {
      const rect = this.getBoundingClientRect()
      if (rect.width === 0 || rect.height === 0) return

      const rawX = (e.clientX - rect.left) / rect.width
      const rawY = (e.clientY - rect.top) / rect.height

      this.targetNormX = Math.max(0, Math.min(1, rawX))
      this.targetNormY = Math.max(0, Math.min(1, rawY))
      this.targetOffsetX = (this.targetNormX - 0.5) * 2
      this.targetOffsetY = (this.targetNormY - 0.5) * 2
    }

    startLoop() {
      if (!this.rafId) {
        this.rafId = requestAnimationFrame(this.tick)
      }
    }

    tick() {
      const ease = 0.1

      this.currentOffsetX += (this.targetOffsetX - this.currentOffsetX) * ease
      this.currentOffsetY += (this.targetOffsetY - this.currentOffsetY) * ease
      this.currentNormX += (this.targetNormX - this.currentNormX) * ease
      this.currentNormY += (this.targetNormY - this.currentNormY) * ease

      const targetScale = this.isHovered ? 1.08 : 1.0
      this.currentScale += (targetScale - this.currentScale) * ease

      const tiltX = -this.currentOffsetY * 3.5
      const tiltY = this.currentOffsetX * 3.5
      const shiftX = this.currentOffsetX * 5
      const shiftY = this.currentOffsetY * 5

      if (this.inner) {
        if (this.isHovered) {
          this.inner.style.transform = `perspective(1000px) scale(${this.currentScale.toFixed(4)}) rotateX(${tiltX.toFixed(2)}deg) rotateY(${tiltY.toFixed(2)}deg) translate3d(${shiftX.toFixed(1)}px, ${shiftY.toFixed(1)}px, 30px)`
        } else if (Math.abs(this.currentScale - 1) > 0.002 || Math.abs(shiftX) > 0.1) {
          this.inner.style.transform = `perspective(1000px) scale(${this.currentScale.toFixed(4)}) rotateX(${tiltX.toFixed(2)}deg) rotateY(${tiltY.toFixed(2)}deg) translate3d(${shiftX.toFixed(1)}px, ${shiftY.toFixed(1)}px, 0)`
        } else {
          this.inner.style.transform = ''
        }
      }

      if (this.media && this.isImage) {
        const isHighlighted = this.getAttribute('data-highlighted') === 'true'
        if (isHighlighted) {
          const posY = (this.currentNormY * 18).toFixed(1)
          const posX = (49 + this.currentNormX * 2).toFixed(1)
          ;(this.media as HTMLImageElement).style.objectPosition = `${posX}% ${posY}%`
        } else {
          const posY = (this.currentNormY * 100).toFixed(1)
          const posX = (48 + this.currentNormX * 4).toFixed(1)
          ;(this.media as HTMLImageElement).style.objectPosition = `${posX}% ${posY}%`
        }
      }

      const isSettled =
        !this.isHovered &&
        Math.abs(this.currentScale - 1) < 0.001 &&
        Math.abs(this.currentOffsetX) < 0.002 &&
        Math.abs(this.currentOffsetY) < 0.002 &&
        (!this.isImage || Math.abs(this.currentNormY) < 0.002)

      if (!isSettled) {
        this.rafId = requestAnimationFrame(this.tick)
      } else {
        if (this.inner && !this.isHovered) {
          this.inner.style.transform = ''
        }
        this.rafId = null
      }
    }
  }

  customElements.define('a-work', AWork)
</script>

<style lang="scss">
  a-work {
    position: relative;
    top: 0; left: 0;

    display: block;
    margin: 0;
    padding: 0.5rem 0.5rem 0;

    background: transparent;
    content-visibility: visible;

    transform-style: preserve-3d;

    will-change: transform;

    @include mq(phone) { padding: 0.25rem; }

    &.is-hovered,
    &:hover {
      z-index: 9999 !important;
    }

    a {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    .a__inner {
      display: block;
      margin: 0;
      padding: 0;
      position: relative;
      background: color(secondary);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 4px;
      overflow: hidden;
      transform-style: preserve-3d;
      will-change: transform;
      transition: border-color 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                  box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    &.is-hovered .a__inner,
    &:hover .a__inner {
      border-color: var(--accent, rgba(255, 255, 255, 0.35));
      box-shadow:
        0 24px 55px -12px rgba(0, 0, 0, 0.92),
        0 0 32px color-mix(in srgb, var(--accent) 25%, transparent);
    }

    .a__media-wrap {
      position: relative;
      overflow: hidden;
      width: 100%;
      height: 100%;
      background: #0c1015;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* ─── Image variant ─── */
    .a__img-viewport {
      position: relative;
      width: 100%;
      max-width: 50vw;
      height: 30vw;
      max-height: 50vh;
      min-width: 300px;
      min-height: 200px;
      overflow: hidden;
      background: #0c1015;

      @include mq(phone) {
        max-width: 80vw;
        height: 50vw;
        max-height: 80vh;
      }
    }

    .a__img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      will-change: object-position;
      user-select: none;
      pointer-events: none;
    }

    .a__img-tag {
      position: static;
      display: inline-block;
      padding: 4px 8px;
      background: rgba(0, 0, 0, 0.78);
      border: 1px solid var(--accent, rgba(255,255,255,0.35));
      color: var(--accent, #fff);
      font: 700 8.5px / 1 'PP Fraktion Mono', monospace;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      backdrop-filter: blur(8px);
      box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 30%, transparent);
      border-radius: 2px;
      pointer-events: auto;
    }

    /* ─── Topbar inside Image Viewport ─── */
    .a__view-topbar {
      position: absolute;
      top: 10px;
      left: 10px;
      right: 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      z-index: 10;
      pointer-events: none;
    }

    .a__view-top-left {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }

    .a__status-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 7px;
      background: rgba(5, 7, 10, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 2px;
      font: 700 8px / 1 'PP Fraktion Mono', monospace;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent, #fff);
      backdrop-filter: blur(6px);
      pointer-events: auto;
    }

    .a__status-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--accent, #39e75f);
      box-shadow: 0 0 6px var(--accent, #39e75f);
      animation: a-pulse 1.6s infinite ease-in-out;
    }

    .a__repo-link-chip {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 8px;
      background: rgba(10, 14, 20, 0.88);
      border: 1px solid var(--accent, rgba(255, 255, 255, 0.35));
      border-radius: 2px;
      color: #ffffff;
      font: 700 8.5px / 1 'PP Fraktion Mono', monospace;
      letter-spacing: 0.1em;
      text-decoration: none;
      backdrop-filter: blur(8px);
      transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
      pointer-events: auto;
      box-shadow: 0 2px 8px rgba(0,0,0,0.4);

      .a__gh-icon {
        flex-shrink: 0;
      }

      &:hover {
        background: var(--accent, #39e75f);
        color: #06080c;
        border-color: var(--accent, #39e75f);
        transform: translateY(-1px);
      }
    }

    /* ─── Gallery Tab Switcher ─── */
    .a__gallery-bar {
      position: absolute;
      top: 42px;
      left: 10px;
      display: inline-flex;
      gap: 4px;
      z-index: 10;
      pointer-events: auto;

      @include mq(phone) {
        top: 38px;
        gap: 3px;
      }
    }

    .a__gallery-btn {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 7px;
      background: rgba(8, 10, 14, 0.82);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 2px;
      color: #cbd5e1;
      font: 700 7.5px / 1 'PP Fraktion Mono', monospace;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
      backdrop-filter: blur(6px);
      transition: all 0.2s ease;

      .a__gallery-btn-dot {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.4);
      }

      &.is-active,
      &:hover {
        border-color: var(--accent, #ff782d);
        color: #ffffff;
        background: rgba(12, 16, 24, 0.95);

        .a__gallery-btn-dot {
          background: var(--accent, #ff782d);
          box-shadow: 0 0 6px var(--accent, #ff782d);
        }
      }
    }

    /* ─── Deep Architectural HUD Overlay ─── */
    .a__img-viewport--highlighted {
      height: 33vw;
      max-height: 56vh;

      @include mq(phone) {
        height: 58vw;
        max-height: 84vh;
      }
    }

    .a__deep-scrim {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(180deg, transparent 0%, rgba(6, 8, 12, 0.8) 18%, rgba(6, 8, 12, 0.96) 100%);
      padding: 0.9rem 1.1rem 0.8rem;
      backdrop-filter: blur(8px);
      border-top: 1px solid rgba(255, 255, 255, 0.09);
      z-index: 8;
      pointer-events: auto;
      transition: background 0.3s ease, border-color 0.3s ease;

      @include mq(phone) {
        padding: 0.6rem 0.75rem;
      }
    }

    .a__deep-content {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .a__deep-meta {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .a__deep-title {
      margin: 0;
      font: 700 1.05rem / 1.2 'PP Fraktion Mono', monospace;
      color: #ffffff;
      letter-spacing: 0.01em;

      @include mq(phone) {
        font-size: 0.9rem;
      }
    }

