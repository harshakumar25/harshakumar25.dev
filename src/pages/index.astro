    </div><!-- .site-wrapper -->

    <div
      class="site-intro js-intro"
      style="opacity: 1; position: fixed; top: 0; left: 0; z-index: 50; width: 100%; height: 100%; background: #07090e;"
    >
      <!-- FULL-SCREEN BACKGROUND EXPLOIT SEQUENCER -->
      <div class="intro-bg-stage js-intro-exploit">
        <!-- Frame 1: Recon State -->
