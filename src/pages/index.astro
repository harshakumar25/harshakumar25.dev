        <div class="intro-loader__center">
          <!-- Bug Patched Overlay Modal (shows during step 6) -->
          <div class="intro-exploit__patched-card js-patched-modal">
            <div class="intro-exploit__patched-shield">
              <svg viewBox="0 0 24 24" class="intro-exploit__shield-icon" fill="none" stroke="#39e75f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <polyline points="9 12 11 14 15 10"/>
              </svg>
            </div>
            <div class="intro-exploit__patched-meta">
              <span class="intro-exploit__patched-tag">ZERO-DAY MITIGATION</span>
