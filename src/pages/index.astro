          <div class="intro-bg-frame__ambient" style="background-image: url('/images/exploit-sequence/step-4.jpg');"></div>
          <img src="/images/exploit-sequence/step-4.jpg" alt="Draining Funds 56%" class="intro-bg-frame__img" />
        </div>

        <!-- Frame 5: Exploit Successful $0.00 -->
        <div class="intro-bg-frame js-exploit-frame" data-step="5">
          <div class="intro-bg-frame__ambient" style="background-image: url('/images/exploit-sequence/step-5.png');"></div>
          <img src="/images/exploit-sequence/step-5.png" alt="Exploit Successful $0.00" class="intro-bg-frame__img" />
        </div>

        <!-- Frame 6: Bug Patched Secured State -->
        <div class="intro-bg-frame intro-bg-frame--patched js-exploit-frame" data-step="6">
          <div class="intro-bg-frame__ambient intro-bg-frame__ambient--emerald" style="background-image: url('/images/exploit-sequence/step-1.jpg');"></div>
          <img src="/images/exploit-sequence/step-1.jpg" alt="Telegram Wallet Secured" class="intro-bg-frame__img intro-bg-frame__img--blur" />
        </div>

        <!-- Atmospheric Vignette, Scanlines & Cyber Grid -->
        <div class="intro-bg-vignette"></div>
        <div class="intro-bg-scanline"></div>
        <div class="intro-bg-grid"></div>
      </div><!-- .intro-bg-stage -->

      <!-- Quick Skip Button -->
      <button type="button" class="intro-skip-btn js-intro-skip" title="Skip Intro">
        <span>SKIP</span>
        <svg viewBox="0 0 16 16" width="10" height="10" fill="currentColor">
          <path d="M12.7 7.3a1 1 0 0 1 0 1.4l-5 5a1 1 0 1 1-1.4-1.4L10.58 8 6.3 3.7a1 1 0 0 1 1.4-1.4l5 5z"/>
