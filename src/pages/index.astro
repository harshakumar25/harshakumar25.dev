            <div class="intro-exploit__patched-status">
              <span class="intro-exploit__patched-led"></span>
              <span>RESPONSIBLY DISCLOSED &bull; BUG PATCHED ✓</span>
            </div>
          </div>

          <!-- Step Indicator Pills (Floating Over Background) -->
          <div class="intro-exploit__stepper">
            <span class="intro-exploit__step-pill js-step-pill is-active" data-step="1">01 RECON</span>
            <span class="intro-exploit__step-pill js-step-pill" data-step="2">02 INJECT</span>
            <span class="intro-exploit__step-pill js-step-pill" data-step="3">03 HIJACK</span>
            <span class="intro-exploit__step-pill js-step-pill" data-step="4">04 DRAIN</span>
            <span class="intro-exploit__step-pill js-step-pill" data-step="5">05 PWNED</span>
            <span class="intro-exploit__step-pill intro-exploit__step-pill--patch js-step-pill" data-step="6">06 PATCHED ✓</span>
          </div>
        </div><!-- .intro-loader__center -->

        <!-- Bottom HUD Telemetry -->
        <div class="intro-loader__hud">
          <div class="intro-loader__meta">
            <span class="intro-loader__title js-loader-headline">TARGET: TELEGRAM WALLET MINI-APP</span>
            <span class="intro-loader__percent js-loader-percent">00%</span>
          </div>

          <div class="intro-loader__bar">
            <div class="intro-loader__fill js-loader-fill"></div>
